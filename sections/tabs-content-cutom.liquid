<style>
  .custom-pagination-wrapper {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 10;
  }

  .custom-arrow {
    background: linear-gradient(to right, #fff 50%, rgba(0, 0, 0, 0.8) 50%);
    background-size: 200% 100%;
    background-position: left bottom;
    color: rgba(0, 0, 0, 0.5);
    border: none;
    cursor: pointer;
    padding: 14px;
    pointer-events: auto;
    opacity: 0;
    transition: opacity 0.3s ease, background-position 0.4s ease, color 0.4s ease;
  }

  /* Hover đổi màu và kéo gradient */
  .custom-arrow:hover {
    background-position: right bottom;
    color: #fff;
  }

  /* Chỉ hiện khi hover vào khu vực panel */
  .tabs__panel:hover .custom-arrow {
    opacity: 1;
  }
</style>
