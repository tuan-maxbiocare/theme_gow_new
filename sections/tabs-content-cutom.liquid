{%- liquid
  assign nav_style = section.settings.navigation_style

  if nav_style == 'buttons'
    assign nav_button_class = 'btn btn--icon'
    assign nav_button_text_class = 'btn__text text-pcard-title'
  else
    assign nav_button_class = 'tabs__tab btn btn--underline focus-inset'
    assign nav_button_text_class = 'tabs__tab-name h3 text-inherit'
  endif

  assign image_with_text_blocks = section.blocks | where: 'type', 'image_with_text'
  assign sidebar = section.blocks | where: 'type', 'sidebar' | first

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign enable_swipe_mobile = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign enable_swipe_mobile = true
  endif

  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = columns_desktop
  if columns_desktop > 3
    assign columns_tablet = columns_desktop | divided_by: 2.0 | ceil
  endif

  assign header_alignment = section.settings.section_header_alignment
  assign header_alignment_mobile = section.settings.section_header_alignment_mobile
  if header_alignment_mobile == 'inherit'
    assign header_alignment_mobile = header_alignment
  endif
-%}
{% comment %} dòng 17 - 32 của muilticolumn {% endcomment %}
{{ 'component-tabs.css' | asset_url | stylesheet_tag }}
{%- if sidebar -%}
  {{ 'component-help-sidebar.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if image_with_text_blocks != blank -%}
  {{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{{ 'section-slideshow.css' | asset_url | stylesheet_tag: preload: true }}
{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
<style>
@media (min-width: 1024px) {
  .tabs-content_tabs__panel-custom {
    margin: auto;
    width: {{ section.settings.content_width }}%;
  }
}
</style>

<div
  class="section section-tabs-content section-{{ section.id }} section--padding page-width page-width--{{ section.settings.container }} color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-id="{{ section.id }}"
>
  {%- if section.blocks.size > 0 -%}
    <div class="flex flex-col md:flex-row{% if sidebar != blank %} help-sidebar__wrapper help-sidebar--{{ sidebar.settings.position }}{% endif %}">
      <tabs-component class="flex-1 tabs tabs-nav--{{ nav_style }}">
        <div
          class="tabs__header flex justify-{{ section.settings.navigation_alignment }}"
          role="tablist"
        >
          <div class="tabs__nav-wrap">
            <div class="tabs__nav tabs__nav-js">
              {%- liquid
                assign tab_number = 1
              -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  if block.type == 'sidebar'
                    continue
                  endif
                  if block.settings.navigation_title != blank
                    assign tab_name = block.settings.navigation_title
                  else
                    assign tab_name = 'Tab ' | append: tab_number
                  endif

                  assign tab_number = tab_number | plus: 1
                -%}
                <button class="{{ nav_button_class }}" role="tab" id="{{- block.id -}}" {{ block.shopify_attributes }}>
                  <span
                    class="{{ nav_button_text_class }}"
                    style="--navigation-font-size: {{ section.settings.navigation_font_size}}px"
                  >
                    {{- tab_name -}}
                  </span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        </div>


        <div class="tabs-content_tabs__panel-custom">
          <div class="tabs__panel">
            {%- liquid
              assign tab_index = 0
            -%}
            {% assign entry_metaobjects = metaobjects.product_details_section[section.settings.tab_content_html] %}
            {%- for block in section.blocks -%}
              {%- liquid
                if block.type == 'sidebar'
                  continue
                endif
              -%}
              <div
                class="tabs__content"
                id="tab-{{ block.id }}"
                data-index="{{ tab_index }}"
                role="tabpanel"
                {% unless tab_index == 0 %}
                  hidden
                {% endunless %}
              >
                {%- case block.type -%}
                  {%- when 'image_with_text' -%}
                    {%- liquid
                      assign image_position = block.settings.desktop_image_position

                      assign aspect_ratio = block.settings.image_aspect_ratio | default: '1/1'
                      if aspect_ratio == 'adapt'
                        if block.settings.image != blank
                          assign aspect_ratio = block.settings.image.aspect_ratio
                        else
                          assign aspect_ratio = '1/1'
                        endif
                      endif

                      assign loading = 'lazy'
                      assign fetchpriority = 'low'
                      if section.index < 2 and tab_index == 0
                        assign loading = 'eager'
                        assign fetchpriority = 'high'
                      endif
                      assign motion_delay = 50
                    -%}
                    {% capture sizes %}
                  (min-width: 768px) calc(min({{ settings.page_width }}px, 100vw) / 2), calc(100vw - 3rem)
                  {% endcapture %}
                    <div
                      class="image-with-text__wrapper image-with-text--image-{{ image_position }} flex flex-col md:flex-row gap-y-6"
                      style="--image-width: 50%; gap: 30px"
                    >
                      <div
                        class="image-with-text__media self-start{% if image_position == 'right' %} md:order-last{% endif %}"
                      >
                        <div class="block overlow-hidden blocks-radius">
                          <motion-element
                            data-motion="zoom-out"
                            data-motion-delay="{{ motion_delay }}"
                            class="block media-wrapper hover-wrapper blocks-radius{% if block.settings.image == blank %} bg-none{% endif %}"
                            style="--aspect-ratio: {{ aspect_ratio }};"
                          >
                            {%- if block.settings.image != blank -%}
                              {{
                                block.settings.image
                                | image_url: width: block.settings.image.width
                                | image_tag:
                                  loading: loading,
                                  fetchpriority: fetchpriority,
                                  class: 'motion-reduce hover-scale-up',
                                  widths: '375, 550, 670, 750, 1100, 1340, 1500, 1780, 2000, 3000, 3840',
                                  sizes: sizes,
                                  is: 'image-lazy'
                              }}
                            {%- else -%}
                              {{ 'image' | placeholder_svg_tag: 'placeholder-svg w-full h-full hover-scale-up' }}
                            {%- endif -%}
                          </motion-element>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        </div>
                      </div>
                      <div
                        class="image-with-text__inner flex-1 md:flex"
                        style="
                          border: 1px solid #e5e7eb;
                          background: #ffffff;
                          border-radius: 12px;
                          padding: 3.5rem 3.5rem;
                        "
                      >
                        <div class="image-with-text__content w-full rich-text md:text-left text-left">
                          {%- if block.settings.subheading != blank -%}
                            <motion-element
                              data-motion="fade-up"
                              data-motion-delay="{{ motion_delay }}"
                              class="block rich-text__subheading text-subheading"
                            >
                              {{ block.settings.subheading }}
                            </motion-element>
                            {%- assign motion_delay = motion_delay | plus: 50 -%}
                          {%- endif -%}
                          {%- if block.settings.heading != blank -%}
                            <h2 class="rich-text__heading inline-richtext {{ block.settings.heading_size }}">
                              <motion-element
                                class="block"
                                data-motion="fade-up"
                                data-motion-delay="{{ motion_delay }}"
                              >
                                {% render 'highlight-text',
                                  hl_text: block.settings.heading,
                                  hl_style: block.settings.highlight_style,
                                  hl_font_style: block.settings.highlight_font_style,
                                  hl_style_color: block.settings.highlight_style_color,
                                  hl_text_color: block.settings.highlight_text_color
                                %}
                              </motion-element>
                            </h2>
                            {%- assign motion_delay = motion_delay | plus: 50 -%}
                          {%- endif -%}
                          {%- if block.settings.description != blank -%}
                            <motion-element
                              data-motion="fade-up"
                              data-motion-delay="{{ motion_delay }}"
                              class="block rich-text__text text-subtext rte {{ block.settings.description_size }}"
                            >
                              {{ block.settings.description }}
                            </motion-element>
                            {%- assign motion_delay = motion_delay | plus: 50 -%}
                          {%- endif -%}

                          {%- if block.settings.enable_collapsible != blank
                            and section.settings.enable_collapsible_all
                          -%}
                            <motion-element
                              data-motion="fade-up"
                              data-motion-delay="{{ motion_delay }}"
                              class="block rich-text__table"
                            >
                              {% if block.settings.enable_collapsible %}
                                {% render 'collapsible-tab-table',
                                  block: block,
                                  section_id: section.id,
                                  collapsible_heading: block.settings.collapsible_heading,
                                  collapsible_heading_size: block.settings.collapsible_heading_size
                                %}
                              {% endif %}
                            </motion-element>
                            {%- assign motion_delay = motion_delay | plus: 50 -%}
                          {%- endif -%}

                          {%- if block.settings.button_label != blank -%}
                            <motion-element
                              data-motion="fade-up"
                              data-motion-delay="{{ motion_delay }}"
                              class="block rich-text__button"
                            >
                              {% render 'button',
                                button_style: block.settings.button_style,
                                button_link: block.settings.button_link,
                                button_label: block.settings.button_label,
                                button_icon: block.settings.button_icon
                              %}
                            </motion-element>
                            {%- assign motion_delay = motion_delay | plus: 50 -%}
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {%- when 'tab' -%}
                    <div class="page__content rte text-subtext">
                      {% if entry_metaobjects %}
                        {%- assign field_index = forloop.index0 | plus: 1 -%}
                        {%- assign field_name = 'product_detail_rich_text_' | append: field_index -%}

                        {%- assign content = entry_metaobjects[field_name] -%}

                        {% if content %}
                          {{ content | raw }}
                        {% endif %}
                      {% endif %}
                      {{ block.settings.tab_content }}
                      {{ block.settings.custom_liquid }}
                      {{ block.settings.page.content }}

                      {% if block.settings.enable_collapsible_tab %}
                        {% render 'collapsible-tab-table', block: block, section_id: section.id %}
                      {% endif %}
                    </div>
                    {% comment %} image gallery {% endcomment %}
                  {%- when 'images' -%}
                    <div class="image-gallery">
                      {%- if block.settings.image != blank -%}
                        <div class="f-column">
                          <motion-element class="block media-wrapper" data-motion="zoom-out-sm">
                            {%- liquid
                              assign image = block.settings.image
                              assign alt_text = image.alt | default: shop.name | escape
                            -%}
                            {{
                              image
                              | image_url: width: 1500
                              | image_tag:
                                loading: loading,
                                fetchpriority: fetchpriority,
                                class: 'motion-reduce',
                                widths: '375, 550, 750, 1100, 1500',
                                sizes: '(min-width: 750px) 1100px, calc(100vw - 30px)',
                                is: 'image-lazy',
                                alt: alt_text,
                                style: 'border-radius: 12px; height: 100%; width: 100%; object-fit: cover;'
                            }}
                          </motion-element>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- when 'multicolumn' -%}
                    <div class="multicolumn grid grid-cols-{{ section.settings.columns_desktop }} gap-{{ section.settings.column_gap }}">
                      {% render 'multicolumn-block', block: block, section: section %}
                    </div>
                {%- endcase -%}
                {%- if section.settings.show_pagination -%}
                  <div class="custom-pagination-wrapper">
                    <button
                      class="custom-arrow custom-arrow-prev"
                    >
                      {% render 'icon-caret-left' %}
                    </button>
                    <button
                      class="custom-arrow custom-arrow-next"
                    >
                      {% render 'icon-caret-right' %}
                    </button>
                  </div>
                {%- endif -%}
              </div>
              {%- assign tab_index = tab_index | plus: 1 -%}
            {%- endfor -%}
          </div>
        </div>
      </tabs-component>
      {%- if sidebar != blank -%}
        {% render 'help-sidebar', sidebar: sidebar %}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Tab content Custom",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.general.name"
    },
    {
      "type": "metaobject",
      "id": "tab_content_html",
      "label": "Tab content HTML",
      "metaobject_type": "product_details_section"
    },
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "full",
          "label": "t:general.container.options__full.label"
        },
        {
          "value": "fixed",
          "label": "t:general.container.options__fixed.label"
        }
      ],
      "default": "fixed",
      "label": "t:general.container.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.tabs-content.settings.tab_settings.content"
    },
    {
      "type": "select",
      "id": "navigation_style",
      "label": "t:sections.tabs-content.settings.navigation_style.label",
      "default": "headings",
      "options": [
        {
          "value": "headings",
          "label": "t:sections.tabs-content.settings.navigation_style.options__1.label"
        },
        {
          "value": "buttons",
          "label": "t:sections.tabs-content.settings.navigation_style.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "navigation_alignment",
      "label": "t:general.text_alignment.label",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "t:general.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:general.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:general.text_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "navigation_font_size",
      "label": "Navigation font size (px)",
      "min": 12,
      "max": 40,
      "step": 1,
      "default": 16
    },
    {
      "type": "header",
      "content": "t:general.padding.section_heading.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:general.padding.top.label",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:general.padding.bottom.label",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "content width %",
      "default": 80,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:general.divider.section_heading.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:general.divider.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:general.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:general.container.options__full.label"
        }
      ],
      "default": "fixed",
      "label": "t:general.divider.width.label"
    },
    /* setting paginantion */
    {
      "type": "header",
      "content": "Pagination Settings"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination",
      "default": true
    },
    /* collapsible settings */
    {
      "type": "header",
      "content": "Collapsible Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_collapsible_all",
      "label": "Enable collapsible for all image with text",
      "default": true
    },
    {
      "type": "header",
      "content": "Multicolumn Settings"
    },
    {
      "id": "section_header_alignment",
      "type": "select",
      "label": "t:general.text_alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:general.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:general.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:general.text_alignment.options__3.label"
        }
      ]
    },
    {
      "id": "section_header_alignment_mobile",
      "type": "select",
      "label": "t:general.text_alignment.mobile.label",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "t:general.text_alignment.options__4.label"
        },
        {
          "value": "left",
          "label": "t:general.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:general.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:general.text_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:general.subheading.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Multicolumn",
      "label": "t:general.heading.label",
      "info": "t:general.heading.info"
    },
    {
      "type": "select",
      "id": "highlight_style",
      "label": "t:general.highlight_text.highlight_style.label",
      "options": [
        {
          "value": "none",
          "label": "t:general.highlight_text.highlight_style.options.option__1.label"
        },
        {
          "value": "hand_drawn_circle",
          "label": "t:general.highlight_text.highlight_style.options.option__2.label"
        },
        {
          "value": "thick_underline",
          "label": "t:general.highlight_text.highlight_style.options.option__3.label"
        },
        {
          "value": "wave_underline",
          "label": "t:general.highlight_text.highlight_style.options.option__4.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "highlight_font_style",
      "label": "t:general.highlight_text.highlight_font_style.label",
      "options": [
        {
          "value": "italic",
          "label": "t:general.highlight_text.highlight_font_style.options.option__1.label"
        },
        {
          "value": "normal",
          "label": "t:general.highlight_text.highlight_font_style.options.option__2.label"
        }
      ]
    },
    {
      "type": "color",
      "id": "highlight_style_color",
      "label": "t:general.highlight_text.highlight_style_color.label"
    },
    {
      "type": "color",
      "id": "highlight_text_color",
      "label": "t:general.highlight_text.highlight_text_color.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:general.text_size.heading.label",
      "default": "h1",
      "options": [
        {
          "value": "h5",
          "label": "t:general.text_size.options__h5.label"
        },
        {
          "value": "h4",
          "label": "t:general.text_size.options__h4.label"
        },
        {
          "value": "h3",
          "label": "t:general.text_size.options__h3.label"
        },
        {
          "value": "h2",
          "label": "t:general.text_size.options__h2.label"
        },
        {
          "value": "h1",
          "label": "t:general.text_size.options__h1.label"
        },
        {
