{{ 'section-buttons-with-icon.css' | asset_url | stylesheet_tag }}
<script src="{{ 'buttons-with-icon-list.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign enable_slider = section.settings.enable_slider
-%}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

{%- style -%}
    .section-{{ section.id }}:has(.swiper-button-lock) .button-list__items {
      justify-content: {{ section.settings.item_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end' }};
    }
     .button-item__inner.active {
      background-color: #000; 
      color: #000; 
      text-decoration: underline;
    }
    .section-{{ section.id }} .button-item__inner.active .button-item__icon {
      background-color: #000;
      border-color: #000;
    }

    .section-{{ section.id }} .button-item__inner.active .button-item__icon svg {
      color: #fff;
    }
    
    .section-{{ section.id }} .button-item__text{
      font-size: 20px;  
    }
    .section-{{ section.id }} .button-item__inner {
      border: none !important;   
      box-shadow: none !important;
      
    }
    /* Hover mới */
    .section-{{ section.id }} .button-item__inner:hover .button-item__text {
      text-decoration: underline;   
      color: #000;  
    }

    .section-{{ section.id }} .button-item__inner:hover .button-item__icon {
      color: #000;  
      fill: #000;
    }
    /* Bỏ pseudo-element hiệu ứng mặc định */
    .section-{{ section.id }} .button-item__inner::before,
    .section-{{ section.id }} .button-item__inner::after {
      content: none !important;
      display: none !important;
    }

    /* Reset style mặc định */
    .section-{{ section.id }} .button-item__inner {
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      transition: none !important;
    }
    .section-{{ section.id }} .button-list__item:not(:last-child) {
      position: relative;
    }

    .section-{{ section.id }} .button-list__item:not(:last-child)::after {
      content: "";
      position: absolute;
      top: 50%;
      right: 0;
      transform: translateY(-50%);
      width: 1px;
      height: 30px;        
      background-color: #ddd;
    }
    .section-{{ section.id }} .button-item__icon {
      position: relative;
      align-items: center;
      justify-content: center;
      border: 1px solid #e5e7eb;
      overflow: hidden; 
      transition: border-color 0.3s ease;

    }
    .section-{{ section.id }} .button-item__icon::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 0%;
      height: 100%;
      background: #000; 
      transition: width 0.4s ease;
      z-index: 0;
    }
    .section-{{ section.id }} .button-item__icon svg {
      width: 10px;   
      height: 18px;
      position: relative;
      z-index: 1;
      color: #333;
      transition: color 0.3s ease;
    }

    /* Hover button hoặc hover icon → fill icon */
    .section-{{ section.id }} .button-item__inner:hover .button-item__icon::before,
    .section-{{ section.id }} .button-item__icon:hover::before {
      width: 100%;
    }
    .section-{{ section.id }} .button-item__inner:hover .button-item__icon svg,
    .section-{{ section.id }} .button-item__icon:hover svg {
      color: #fff;
    }
    .section-{{ section.id }} .button-item__inner:hover .button-item__icon,
    .section-{{ section.id }} .button-item__icon:hover {
      border-color: #000;
    }
    @media (max-width: 767px) {
    /* Container giữ logo + button ngang */
    .section-{{ section.id }} .section__content {
      display: flex !important;
      flex-direction: row !important;
      align-items: center;
      flex-wrap: nowrap !important;
    }

    /* Logo */
    .section-{{ section.id }} .custom-image-wrapper {
      flex: 0 0 auto;
      width: 120px;
      margin-right: 0px !important;
    }
    .section-{{ section.id }} .custom-image {
      display: block;
      width: 100%;
      height: auto;
    }

    /* Danh sách button ngang */
    .section-{{ section.id }} .button-list__items {
      display: flex !important;
      flex-wrap: nowrap !important;
      flex: 1;
      overflow-x: auto;               /* cuộn ngang nếu nhiều */
      -webkit-overflow-scrolling: touch;
    }
    .section-{{ section.id }} .button-list__item {
      flex: 0 0 auto;
    }
    .section-{{ section.id }} .button-item__text{
      font-size: 18px;  
    }
  }
{%- endstyle -%}
<div
  class="section section-{{ section.id }} section--padding button-list color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="section__container page-width page-width--{{ section.settings.container }}">
    {% render 'section-heading', section_settings: section.settings %}
    <div
      class="section__content swiper-show-nav-on-hover inline-flex relative{% if section.settings.swipe_on_mobile %} swipe-mobile swipe-mobile--auto-cols{% endif %}"
      style="align-items: center;"
    >
      <div class="custom-image-wrapper" style="margin-right: {{ section.settings.custom_image_margin_right }}px;">
        {% if section.settings.custom_image != blank %}
          {% assign image_link = section.settings.custom_image_link %}
          {% if image_link != blank %}
            <a href="{{ image_link }}" class="custom-image-link">
          {% endif %}

          <img
            src="{{ section.settings.custom_image | image_url: width: section.settings.custom_image_width }}"
            alt="{{ section.settings.custom_image.alt | default: 'Custom image' }}"
            loading="lazy"
            class="custom-image"
          >

          {% if image_link != blank %}
            </a>
          {% endif %}
        {% endif %}
      </div>
      <button-list
        class="block w-full m-0{% if enable_slider %} swiper overlay-list{% endif %}"
        data-section-id="{{ section.id }}"
        {% if enable_slider %}
          data-slider-reach="begin"
          data-enable-slider="true"
        {% endif %}
      >
        <div class="button-list__items flex{% if enable_slider %} swiper-wrapper{%  else %} flex-wrap justify-{{ section.settings.item_alignment | replace: 'left', 'start' | replace: 'right', 'end' }}{% endif %}{% if section.settings.swipe_on_mobile %} swipe-mobile__inner{% endif %}">
          {%- for block in section.blocks -%}
            <div class="button-list__item{% if enable_slider %} swiper-slide{% endif %}">
              {%- liquid
                assign tag = 'div'
                if block.settings.button_link != blank
                  assign tag = 'a'
                endif
              -%}
              <div
                class="block button-item{% if block.settings.icon_img != blank %} button-item--image{% elsif block.settings.icon != 'none' %} button-item--icon{% endif %}"
                data-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {% assign link = block.settings.button_link | default: '' %}
                {% assign first_char = link | slice: 0, 1 %}

                <{{ tag }}
                  class="
                    button-item__inner hover-wrapper btn {{ section.settings.item_button_style }}
                    {% if link contains shop.domain %}
                      {% assign relative_link = link | remove: 'https://' | remove: 'http://' | remove: shop.domain %}
                      {% if relative_link == request.path %} active{% endif %}
                    {% elsif first_char == '/' %}
                      {% if link == request.path %} active{% endif %}
                    {% endif %}
                  "
                  {% if link != blank %}
                    href="{{ link }}"
                  {% endif %}
                >
                  <span class="btn__text flex items-center gap-x-2">
                    {%- if block.settings.icon_img != blank -%}
                      {%- liquid
                        assign alt = block.settings.icon_img.alt | default: shop.name | escape
                        assign image_widths = '38, 48, 76, 96, 132, ' | append: block.settings.icon_img.width
                      -%}
                      {%- capture image_sizes -%}(min-width:768px) 48px, 38px{%- endcapture -%}
                      <picture
                        class="media-wrapper button-item__icon flex shrink-0 rounded"
                        style="--aspect-ratio: 1;"
                      >
                        {{
                          block.settings.icon_img
                          | image_url: width: block.settings.icon_img.width
                          | image_tag:
                            loading: 'lazy',
                            class: 'motion-reduce absolute inset-0 w-full h-full',
                            widths: image_widths,
                            sizes: image_sizes,
                            is: 'image-lazy',
                            alt: alt
                        }}
                      </picture>
                    {%- endif -%}
                    {%- if block.settings.button_label != blank -%}
                      <span class="button-item__text flex-1{% unless section.settings.item_button_font == 'button' %} font-{{ section.settings.item_button_font }}{% endunless %}">
                        {{- block.settings.button_label -}}
                      </span>
                    {%- endif -%}
                    {% if block.settings.icon != 'none' %}
                      <span class="button-item__icon flex shrink-0 rounded">
                        {% render 'icons', icon: block.settings.icon %}
                      </span>
                    {% endif %}
                  </span>
                </{{ tag }}>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </button-list>
      {%- if enable_slider -%}
        <div class="swiper-controls swiper-controls--nav-floating hidden md:block">
          <button
            class="swiper-button swiper-button-prev btn swiper-button--drop-shadow"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="btn__text"> {% render 'icon-caret-left' %}</span>
          </button>
          <button
            class="swiper-button swiper-button-next btn swiper-button--drop-shadow"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="btn__text"> {% render 'icon-caret-right' %}</span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

