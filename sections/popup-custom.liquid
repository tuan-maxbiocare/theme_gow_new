  width: 300px;
  height: 300px;
  background-color: #fff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
