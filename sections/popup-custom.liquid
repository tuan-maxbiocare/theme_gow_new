{%- liquid
  assign should_show = section.settings.enable
  if section.settings.show_for_visitors_only and customer
    assign should_show = false
  endif

  if section.settings.show_for_homepage_only and template != 'index'
    assign should_show = false
  endif

  if request.design_mode
    assign should_show = true
  endif
-%}
{%- if should_show -%}
  {%- style -%}
    .subscription-popup__teaser {
      position: fixed;
      top: 50%;
      inset-inline-end: 100%;
      transform: translate(-50%, -100%) rotate(-90deg);
      transform-origin: top center;
      border-radius: var(--medium-blocks-radius);
      border-start-start-radius: 0;
      border-start-end-radius: 0;
      height: 4rem;
      padding: 0 1.2rem;
      z-index: 29 !important;
    }
    .subscription-popup__teaser:hover .close-x {
      color: {{ section.settings.teaser_popup_bg }};
    }
  {%- endstyle -%}
  <link rel="stylesheet" href="{{ 'subscription-popup.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'subscription-popup.css' | asset_url | stylesheet_tag }}</noscript>
  {%- liquid
    assign trigger_open = section.settings.trigger_open
    assign repeat_open = section.settings.repeat_open
    assign alignment = section.settings.alignment
    assign width = section.settings.width
    assign show_teaser = section.settings.show_teaser
    assign teaser_button_text = section.settings.teaser_button_text
    assign image_block = section.blocks | where: 'type', 'image' | first
    assign is_top_image = false
    assign modal_css_class = ''

    if image_block != blank
      assign image = image_block.settings.image
      assign image_position = image_block.settings.image_position
      assign modal_css_class = ' subscription-popup__' | append: 'has-image'
      assign modal_css_class = ' subscription-popup__' | append: 'image-' | append: image_position

      if image_position == 'top'
        assign is_top_image = true
      endif
    else
      assign modal_css_class = ' subscription-popup__' | append: 'no-image'
    endif

    assign modal_id = 'SubscriptionModal-' | append: section.id
  -%}
  <subscription-popup
    id="{{ modal_id }}"
    class="drawer modal subscription-popup{{ modal_css_class }}"
    shopify-design-mode
    hidden
    data-trigger-open="{{ trigger_open }}"
    data-repeat-open="{{ repeat_open }}"
    style="--modal-width: {{ width | divided_by: 10.0 }}rem;"
  >
    <div class="fixed-overlay" aria-controls="{{ modal_id }}"></div>

    <div class="drawer__inner blocks-radius" style="background-color: transparent;">
      <button
        class="drawer__close-btn z-2 drawer__close-btn--fill-mobile{% if is_top_image %} drawer__close-btn--fill{% endif %} get-discount-button"
        aria-controls="{{ modal_id }}"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {% render 'icon-close', size: 'large' %}
      </button>
      {%- render 'loading-spinner' -%}

      <style>
        .popup-image-wrapper {
          position: relative;
          display: inline-block;
        }
        .popup-image-wrapper img {
          margin-top: -115px;
        }

        .popup-content {
          position: absolute;
          top: 70%;
          left: 50%;
          transform: translate(-50%, -50%);
          text-align: center;
        }

        .popup-content button {
          background: #fff;
          color: #006343;
          border: none;
          font-size: 3rem;
          padding: 3rem 22rem;
          border-radius: 6px;
          cursor: pointer;
        }

        .popup-content div {
          margin-top: 8px;
          font-size: 14px;
          color: #333;
        }

        .discount-banner-desktop {
          display: block;
        }
        .discount-banner-mobile {
          display: none;
        }

        .get-discount-button {
          color: #fff;
          background-color: transparent;
          box-shadow: none;
        }

        .popup-content .get-discount-button:hover {
          background: #006343;
          color: #fff;
          box-shadow: 0 6px 20px rgba(0, 99, 67, 0.4);
        }

        @media (max-width: 900px) {
          .discount-banner-desktop {
            display: none;
          }
          .discount-banner-mobile {
            display: block;
          }
          .popup-content button {
            font-size: 2rem;
            padding: 2rem 11rem;
          }
          .popup-content {
            top: 67%;
          }
          .popup-image-wrapper img {
            margin-top: -67px;
          }
        }
      </style>

      <div class="drawer__body v-scrollable h-full">
        <div class="discount-banner discount-banner-desktop">
          <img
            src="https://cdn.shopify.com/s/files/1/0677/1900/4417/files/popup-discount.png?v=1762333626"
            alt="discount"
          >

          <div class="popup-custom-info">
            <div class="popup-image-wrapper">
              <img
                src="https://cdn.shopify.com/s/files/1/0677/1900/4417/files/30_sign_in_pop_up-no_button-_desktop.webp?v=1762497627"
                alt="popup"
              >

              <!-- nội dung chồng lên giữa ảnh -->
              <div class="popup-content">
                <button class="btn get-discount-button">Grab It Now</button>
                <div style="color: white">*applies to first orders over $20</div>
              </div>
            </div>
          </div>
        </div>

        <div class="discount-banner discount-banner-mobile">
          <img
            src="https://cdn.shopify.com/s/files/1/0677/1900/4417/files/popup-discount-mobile.png?v=1762337088"
            alt="discount"
          >

          <div class="popup-custom-info">
            <div class="popup-image-wrapper">
              <img
                src="https://cdn.shopify.com/s/files/1/0677/1900/4417/files/30_sign_in_pop_up-no_button-mobile.webp?v=1762497626"
                alt="popup"
              >

              <!-- nội dung chồng lên giữa ảnh -->
              <div class="popup-content">
                <button class="btn get-discount-button">Grab It Now</button>
                <div style="color: white">*applies to first orders over $20</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </subscription-popup>

  {%- if show_teaser and teaser_button_text != blank -%}
    <div class="subscription-popup__teaser ">
      <div>
        <button
          class="btn btn--primary no-js-hidden"

          role="button"
          aria-haspopup="dialog"
          aria-controls="{{ modal_id }}"
          style="
            --color-button: {{ section.settings.teaser_popup_bg.red }},{{ section.settings.teaser_popup_bg.green }},{{ section.settings.teaser_popup_bg.blue }};--color-button-text:{{ section.settings.teaser_popup_text.red }},{{ section.settings.teaser_popup_text.green }},{{ section.settings.teaser_popup_text.blue }};
            padding-right: 55px;border-radius: 0 0 5px 5px;
          "
        >
          <span class="btn__text flex items-center gap-3 relative">
            {%- render 'icon-envelope-simple' -%}
            {{- teaser_button_text -}}
          </span>
        </button>

        <button
          class="close-x btn drawer__close-btn z-2 drawer__close-btn--fill-mobile{% if is_top_image %} drawer__close-btn--fill{% endif %} get-discount-button"
          onclick="this.closest('.subscription-popup__teaser').style.display='none'"
          aria-controls="{{ modal_id }}"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon-close', size: 'small' %}
        </button>
      </div>
    </div>
  {%- endif -%}

  <style>
    .close-x {
      color: {{ section.settings.teaser_popup_text }};
      font-size: 20px;
      padding: 0px;
      position: fixed;
      top: 15%;
      margin-left: 8px;
      right: 36px;
      border: none;
      width: 30px;
      height: 30px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.3s ease;
      border-radius: 100%;
    }
  </style>

  <script src="{{ 'subscription-popup.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div id="popupStep2" style="display: none;">
  {% render 'popup-step2' %}
</div>

<div id="popupStep3" style="display: none;">
  {% render 'popup-step3' %}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const popupStep1 = document.getElementById('{{ modal_id }}');
    const popupStep2 = document.getElementById('popupStep2');
    const popupStep3 = document.getElementById('popupStep3');

    const teaserBtn = document.querySelector('.subscription-popup__teaser');
    const btnToStep2 = document.querySelectorAll('.get-discount-button');
    const closeStep1Btn = document.querySelector(`#${'{{ modal_id }}'} .drawer__close-btn`);
    const closeStep2Btn = document.querySelector('#popupStep2 .popup-close-btn');
    const btnBackToStep2 = document.querySelector('#popupStep3 .step3-continue-btn');
    const closeStep3Btn = document.querySelector('#popupStep3 .step3-close-btn');

    const hideAllSteps = () => {
      [popupStep1, popupStep2, popupStep3].forEach((el) => {
        if (el) {
          el.style.display = 'none';
          el.removeAttribute('open');
          el.setAttribute('hidden', true);
        }
      });
    };

    const showStep = (stepEl) => {
      hideAllSteps();
      if (stepEl) {
        stepEl.style.display = 'flex';
        stepEl.removeAttribute('hidden');
        stepEl.setAttribute('open', true);
      }
      document.body.style.overflow = 'auto';
      document.documentElement.style.overflow = 'auto';
    };

    const lockScroll = () => {
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    };

    const unlockScroll = () => {
      document.body.style.overflow = 'auto';
      document.documentElement.style.overflow = 'auto';
    };

    teaserBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      popupStep1?.removeAttribute('hidden');
      popupStep1?.setAttribute('open', true);
      popupStep1.style.display = 'flex';
      lockScroll();
    });

    btnToStep2.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        popupStep1?.removeAttribute('open');
        popupStep1?.setAttribute('hidden', true);
        showStep(popupStep2);
      });
    });

    closeStep1Btn?.addEventListener('click', (e) => {
      e.preventDefault();
      popupStep1?.removeAttribute('open');
      popupStep1?.setAttribute('hidden', true);
      showStep(popupStep3);
    });

    closeStep2Btn?.addEventListener('click', (e) => {
      e.preventDefault();
      showStep(popupStep3);
    });

    btnBackToStep2?.addEventListener('click', (e) => {
      e.preventDefault();
      showStep(popupStep2);
    });

    closeStep3Btn?.addEventListener('click', (e) => {
      e.preventDefault();
      hideAllSteps();
      unlockScroll();
    });
  });
</script>

{% schema %}
{
