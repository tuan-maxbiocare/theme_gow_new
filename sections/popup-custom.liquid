<div style="display: flex; justify-content: center;">
  <div class="discount-badge">
  <div class="discount-badge__percent">%</div>
  <div class="discount-badge__text-top">ENJOY</div>
  <div class="discount-badge__number">15</div>
  <div class="discount-badge__text-bottom">OFF RRP</div>
</div>
</div>




  <div class="green-box">
    <h3>JUST FOR YOU!</h3>
    <btn class="btn get-discount-button">GRAB IT NOW</btn>
    <small>*applied for first order</small>
  </div>
</div>

        
      </div>
    </div>
  </subscription-popup>
  {%- if show_teaser and teaser_button_text != blank -%}
    <button
      class="subscription-popup__teaser btn btn--primary no-js-hidden"
      role="button"
      aria-haspopup="dialog"
      aria-controls="{{ modal_id }}"
      style="--color-button: {{ section.settings.teaser_popup_bg.red }},{{ section.settings.teaser_popup_bg.green }},{{ section.settings.teaser_popup_bg.blue }};--color-button-text:{{ section.settings.teaser_popup_text.red }},{{ section.settings.teaser_popup_text.green }},{{ section.settings.teaser_popup_text.blue }};"
    >
      <span class="btn__text flex items-center gap-3">
        {%- render 'icon-envelope-simple' %}
        {{- teaser_button_text -}}
      </span>
    </button>
  {%- endif -%}
  <script src="{{ 'subscription-popup.js' | asset_url }}" defer="defer"></script>
{%- endif -%}





<div id="popupStep2" style="display: none;">
  {% render 'popup-step2' %}
</div>

<div id="popupStep3" style="display: none;">
  {% render 'popup-step3' %}
</div>


<script>
document.addEventListener('DOMContentLoaded', () => {
  const popupStep1 = document.getElementById('{{ modal_id }}');
  const popupStep2 = document.getElementById('popupStep2');
  const popupStep3 = document.getElementById('popupStep3');

  const teaserBtn     = document.querySelector('.subscription-popup__teaser');
  const btnToStep2    = document.querySelectorAll('.get-discount-button');   
  const closeStep1Btn = document.querySelector(`#${'{{ modal_id }}'} .drawer__close-btn`);
  const closeStep2Btn = document.querySelector('#popupStep2 .popup-close-btn');
  const btnBackToStep2 = document.querySelector('#popupStep3 .step3-continue-btn');
  const closeStep3Btn = document.querySelector('#popupStep3 .step3-close-btn');

  const hideAllSteps = () => {
    [popupStep1, popupStep2, popupStep3].forEach(el => {
      if (el) {
        el.style.display = 'none';
        el.removeAttribute('open');
        el.setAttribute('hidden', true);
      }
    });
  };

  const showStep = (stepEl) => {
    hideAllSteps();
    if (stepEl) {
      stepEl.style.display = 'flex';
      stepEl.removeAttribute('hidden');
      stepEl.setAttribute('open', true);
    }
    document.body.style.overflow = 'auto';
    document.documentElement.style.overflow = 'auto';
  };

  const lockScroll = () => {
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';
  };

  const unlockScroll = () => {
    document.body.style.overflow = 'auto';
    document.documentElement.style.overflow = 'auto';
  };

  teaserBtn?.addEventListener('click', e => {
    e.preventDefault();
    popupStep1?.removeAttribute('hidden');
    popupStep1?.setAttribute('open', true);
    popupStep1.style.display = 'flex';
    lockScroll();
  });

  btnToStep2.forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      popupStep1?.removeAttribute('open');
      popupStep1?.setAttribute('hidden', true);
      showStep(popupStep2);
    });
  });

  closeStep1Btn?.addEventListener('click', e => {
    e.preventDefault();
    popupStep1?.removeAttribute('open');
    popupStep1?.setAttribute('hidden', true);
    showStep(popupStep3);
  });

  closeStep2Btn?.addEventListener('click', e => {
    e.preventDefault();
    showStep(popupStep3);
  });

  btnBackToStep2?.addEventListener('click', e => {
    e.preventDefault();
    showStep(popupStep2);
  });

  closeStep3Btn?.addEventListener('click', e => {
    e.preventDefault();
    hideAllSteps();
    unlockScroll();
  });
});
</script>












