  top: 9px;
  right: -25px;
  background-color: #000;
  color: #fff;
  border-radius: 50%;
  width: 100px;
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58px;
  font-weight: bold;
  transform: rotate(10deg);
}

.discount-badge__text-top {
  font-size: 30px;
  margin-bottom: -5px;
  color: #000;
  letter-spacing: 2px;
  font-weight: bold;
}

.discount-badge__number {
  font-size: 189px;
  color: #ff4136;
  line-height: 1;
  margin: -5px 0;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
}

.discount-badge__text-bottom {
  font-size: 30px;
  color: #000;
  letter-spacing: 1px;
  margin-top: -5px;
  font-weight: bold;
