{{ 'component-grid-banner.css' | asset_url | stylesheet_tag }}
{{ 'section-slider-with-multicolumn.css' | asset_url | stylesheet_tag }}
<script src="{{ 'slider-with-multicolumn.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign slider_blocks = section.blocks | where: 'type', 'slide'
  assign image_card_blocks = section.blocks | where: 'type', 'image-card'

  assign first_block = slider_blocks.first
  assign image_ratio = first_block.settings.image.aspect_ratio | default: '1/1'
  if first_block.settings.image_mobile == blank
    assign image_mobile_ratio = image_ratio
  else
    assign image_mobile_ratio = first_block.settings.image_mobile.aspect_ratio
  endif

  assign enable_slider = false
  if slider_blocks.size > 1
    assign enable_slider = true
  endif

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign enable_slider_mobile = false
  if section.settings.swipe_on_mobile and image_card_blocks.size > columns_mobile_int
    assign enable_slider_mobile = true
  endif

  assign autoplay = 0
  if section.settings.autoplay
    assign autoplay = section.settings.autoplay_delay | times: 1000
  endif
-%}
{% style %}
  .section__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6em;
  }

  @media (max-width: 767.98px) {
    .section__inner {
        display: block;
        padding: 0 16px;
    }
    .section__left{
        margin-bottom: 0.6em;
    }
    .section__left .multicolumn__slider .content-overlay {
    padding-bottom: 3rem;
  }
 }
 @media (min-width: 1024px) {
  .section__left .multicolumn__slider .content-overlay {
    padding-bottom: 4.5rem;
  }
}
{% endstyle %}
{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}
{%- capture slide_html -%}
  {%- for block in slider_blocks -%}
    {%- liquid
      assign background_default = block.settings.image
      assign background_mobile = block.settings.image_mobile
      assign image_overlay_opacity = block.settings.image_overlay_opacity
      assign heading = block.settings.heading
      assign subheading = block.settings.subheading
      assign description = block.settings.text
      assign button_label = block.settings.button_label
      assign text_alignment = block.settings.content_alignment
      assign motion_delay = 50
      assign background_default_alt = background_default.alt | default: shop.name | escape

      assign loading = 'lazy'
      assign fetchpriority = 'low'
      if forloop.index == 1 and section.index < 2
        assign loading = 'eager'
        assign fetchpriority = 'high'
      endif
    -%}
    <div 
      class="swiper-slide" 
      role="group"
      data-index="{{ forloop.index0 }}" 
      {{ block.shopify_attributes }} 
      data-type= {{ block.type }}
      data-color-scheme="color-{{ block.settings.color_scheme }}"
    >
      <div 
        class="slide__item-wrap h-full" 
        onclick="window.location.href='{{ block.settings.button_link | escape }}'" 
        style="cursor: pointer;"
      >
        <div class="slide__media blocks-radius">
          <motion-element class="block h-full" data-motion="zoom-out-sm">
            <picture
              class="media-wrapper{% if background_default == blank %} bg-none{% endif %}"
              style="--aspect-ratio: {{ image_ratio }};--aspect-ratio-mobile: {{ image_mobile_ratio }};"
            >
              {%- if background_default != blank -%}
                {%- if background_mobile != blank -%}
                  <source
                    media="(max-width: 767px)"
                    srcset="{{ background_mobile | image_url: width: '400x' }} 400w, {{ background_mobile | image_url: width: '600x' }} 600w, {{ background_mobile | image_url: width: '800x' }} 800w, {{ background_mobile | image_url: width: '1000x' }} 1000w"
                    width="{{ background_mobile.width }}"
                    height="{{ background_mobile.height }}"
                  >
                {%- endif -%}
                {{
                  background_default
                  | image_url: width: 1100
                  | image_tag:
                    loading: loading,
                    fetchpriority: fetchpriority,
                    class: 'motion-reduce absolute inset-0 w-full h-full hover-scale-up',
                    widths: '165, 360, 535, 750, 940, 1100',
                    is: 'image-lazy',
                    alt: background_default_alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg hover-scale-up' }}
              {%- endif -%}
      
              {% if image_overlay_opacity and image_overlay_opacity > 0 %}
                <div
                  class="bg-overlay"
                  style="--color-overlay-alpha: {{ image_overlay_opacity }};"
                ></div>
              {% endif %}
            </picture>
          </motion-element>
        </div>
        {%- if heading != blank or description != blank or button_label != blank or subheading != blank -%}
          <div
            class="slide__content card-media--small content-overlay content-overlay--{{ block.settings.content_position }} flex flex-col bg-none focus-none color-{{ block.settings.color_scheme }}"
            tabindex="-1"
          >
            <div class="slide__text rich-text text-{{ text_alignment }}">
              {%- unless block.settings.subheading == blank -%}
                  <motion-element
                    data-motion="fade-up"
                    data-motion-delay="{{ motion_delay }}"
                    data-text
                    hold
                    class="block slide__subtitle rich-text__subheading text-subheading"
                  >
                    {{- block.settings.subheading -}}
                  </motion-element>
                {%- assign motion_delay = motion_delay | plus: 50 -%}
              {%- endunless -%}
              {%- unless block.settings.heading == blank -%}
                <h2 class="slide__title {{ block.settings.heading_size }} rich-text__heading">
                  <motion-element
                    data-motion="fade-up"
                    data-motion-delay="{{ motion_delay }}"
                    data-text
                    hold
                    class="block"
                  >
                    {% render 'highlight-text',
                      hl_text: block.settings.heading,
                      hl_style: block.settings.highlight_style,
                      hl_font_style: block.settings.highlight_font_style,
                      hl_style_color: block.settings.highlight_style_color,
                      hl_text_color: block.settings.highlight_text_color
                    %}
                  </motion-element>
                </h2>
                {%- assign motion_delay = motion_delay | plus: 50 -%}
              {%- endunless -%}
              {%- unless block.settings.text == blank -%}
                <motion-element
                  class="block slide__description rich-text__text rte"
                  data-motion="fade-up"
                  data-motion-delay="{{ motion_delay }}"
                  data-text
                  hold
                >
                  {{- block.settings.text -}}
                </motion-element>
                {%- assign motion_delay = motion_delay | plus: 50 -%}
              {%- endunless -%}
              {%- unless block.settings.button_label == blank -%}
                <motion-element
                  data-motion="fade-up"
                  data-motion-delay="{{ motion_delay }}"
                  data-text
                  hold
                  class="block slide__buttons rich-text__button"
                >
                  {% render 'button',
                    button_style: block.settings.button_style,
                    button_link: block.settings.button_link,
                    button_label: block.settings.button_label,
                    button_icon: block.settings.button_icon
                  %}
                </motion-element>
                {%- assign motion_delay = motion_delay | plus: 50 -%}
              {%- endunless -%}
            </div>
          </div>
      {% endif %}
      </div>
    </div>
  {% endfor %}
{%- endcapture -%}
<div
  class="section section--padding color-{{ section.settings.color_scheme }}"
  style="
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  "
  data-id="{{ section.id }}"
>
  {%- render 'section-heading',
    section_settings: section.settings,
    description_size: section.settings.description_size,
    button_visible: true,
    button_link: section.settings.button_link,
    button_style: section.settings.button_style,
    button_icon: section.settings.button_icon,
    button_label: section.settings.button_label
  -%}
  <div class="section__inner two-column-layout">
    <!-- Khối bên trái: slide -->
    <div class="section__left">
      <multicolumn-slider
        class="multicolumn-slider f-grid f-grid--gap-{{ section.settings.column_gap }} f-grid--row-gap-{{ section.settings.row_gap }}"

        data-id="{{ section.id }}"
      >
        <div class="multicolumn__slider w-full blocks-radius sticky-element self-start">
          <div
            class="{% if enable_slider %}swiper{% endif %} hover-wrapper"
            aria-live="polite"
            aria-atomic="true"
            data-section-id="{{ section.id }}"
            {% if autoplay > 0 %}
              data-autoplay="{{ autoplay }}"
            {% endif %}
            {% if enable_slider %}
              data-enable-slider="true"
            {% endif %}
            style="{% if autoplay > 0 %}--swiper-autoplay-delay: {{ autoplay | plus: 1000 }}ms;{% endif %}"
          >
            <div class="{% if enable_slider %}swiper-wrapper{% endif %} h-full">
              {{ slide_html }}
            </div>
            {%- if enable_slider -%}
              <div class="swiper-controls swiper-controls--float-bottom swiper-controls--grouped swiper-controls--pagination-bullets bg-none justify-center color-{{ section.blocks.first.settings.color_scheme }}">
                <button class="swiper-button swiper-button-prev swiper-button--blank" name="previous">
                  {% render 'icon-slider-prev' %}
                </button>
                <div class="swiper-pagination"></div>
                <button class="swiper-button swiper-button-next swiper-button--blank" name="next">
                  {% render 'icon-slider-next' %}
                </button>
              </div>
            {%- endif -%}
          </div>
        </div>
      </multicolumn-slider>
    </div>

    <!-- Khối bên phải: banner card -->
    <div class="section__right">
      <div class="grid-banner">
        <div
          class="grid-banner__inner f-grid f-grid--gap-{{ section.settings.gap }} f-grid-auto-rows--{{ section.settings.banner_height }}"
          style="--f-columns-md: 2;--f-columns-lg: {{ section.settings.columns }};"
        >
          {%- for block in section.blocks -%}
            {%- if block.type == 'banner-card' -%}
              <div
                class="f-column grid-banner__item w-full {{ block.settings.block_custom_class }}"
                style="--cell-c-span: {{ block.settings.column_span }};--cell-r-span: {{ block.settings.row_span }};"
              >
                {%- render 'card-image',
                  parent_color_scheme: section.settings.color_scheme,
                  color_scheme: block.settings.color_scheme,
                  link: block.settings.card_link,
                  image: block.settings.image,
                  image_mobile: block.settings.image_mobile,
                  image_ratio: 'adapt',
                  image_overlay_opacity: block.settings.image_overlay_opacity,
                  heading: block.settings.heading,
                  highlight_style: block.settings.highlight_style,
                  highlight_font_style: block.settings.highlight_font_style,
                  highlight_style_color: block.settings.highlight_style_color,
                  highlight_text_color: block.settings.highlight_text_color,
                  heading_size: block.settings.heading_size,
                  subheading: block.settings.subheading,
                  subheading_style: block.settings.subheading_style,
                  description: block.settings.text,
                  description_size: block.settings.text_size,
                  button_label: block.settings.button_label,
                  button_style: block.settings.button_style,
                  button_icon: block.settings.button_icon,
                  button_size: block.settings.button_size,
                  rich_text_size: block.settings.content_gap,
                  content_spacing: block.settings.content_spacing,
                  content_position: block.settings.content_position,
                  content_position_mobile: block.settings.content_position_mobile,
                  content_alignment: block.settings.content_alignment,
                  content_alignment_mobile: block.settings.content_alignment_mobile,
                  enable_preload_image: block.settings.enable_preload_image,
                  section_index: section.index,
                  forloop_index: forloop.index,
                  heading_size_custom: block.settings.heading_size_custom,
                  heading_size_mobile: block.settings.heading_size_mobile
                -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

