{{ 'section-review.css' | asset_url | stylesheet_tag }}
<script src="{{ 'review-rewards.js' | asset_url }}" defer></script>
<div class="page-width page-width--fixed section--padding">
  <div class="page-review-reward">
    <div class="page-review-reward__left">
      {% if section.settings.banner_image %}
        <div class="page-review-reward__banner">
          <img src="{{ section.settings.banner_image | img_url: 'master' }}" alt="Banner">
        </div>
      {% endif %}

      {% if page.content != blank %}
        <div class="page__content rich-text__text rte text-subtext page-review-reward__content--desktop">
          {{ page.content }}
        </div>
      {% endif %}
    </div>

    <div class="page-review-reward__right">
      {% if section.settings.enable_review_buttons %}
        <div class="page-review-reward__checker">
          <p class="page-review-reward__checker-title">
            Have you already left a review on the platform where you purchased the product? <br>
            If not yet, please leave a review, take a screenshot, and fill out the form to join the program.
          </p>
          <div class="page-review-reward__buttons">
            {% if section.settings.link_shopify != blank %}
              <button class="page-review-reward__button" data-link="{{ section.settings.link_shopify }}">
                <img src="{{ section.settings.image_shopify | image_url }}" alt="Garden of Wellness e-shop">
              </button>
            {% endif %}
            {% if section.settings.link_cw != blank %}
              <button class="page-review-reward__button" data-link="{{ section.settings.link_cw }}">
                <img src="{{ section.settings.image_cw | image_url }}" alt="Chemist Warehouse">
              </button>
            {% endif %}
            {% if section.settings.link_aws != blank %}
              <button class="page-review-reward__button" data-link="{{ section.settings.link_aws }}">
                <img src="{{ section.settings.image_aws | image_url }}" alt="Amazon AU">
              </button>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="page-review-reward__form">
        <h3 style="text-align: center;color: #006343;">Enter Now</h3>
        <p class="page-review-reward__form-title">Which platform did you purchase the product from?</p>
        <div id="platform-selection" class="platform-selection">
          <button class="platform-btn" data-platform="gow">
            <img src="{{ section.settings.image_shopify | image_url }}" alt="Garden of Wellness">
            <span>Garden of Wellness</span>
          </button>
          <button class="platform-btn" data-platform="cw">
            <img src="{{ section.settings.image_cw | image_url }}" alt="Chemist Warehouse">
            <span>Chemist Warehouse</span>
          </button>
        </div>
        <div id="gow-search-section" class="search-section" style="display: none;">
          <button class="back-btn" id="back-to-selection">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Back
          </button>
          <p class="search-section__title">Search Your Product</p>
          <div class="page-review-reward__search">
            <input
              type="text"
              id="product-search-input"
              class="page-review-reward__search-input"
              placeholder="Search for products..."
              autocomplete="off"
            >
            <div id="search-results" class="page-review-reward__search-results" style="display: none;"></div>
          </div>
        </div>
      </div>

      {% if page.content != blank %}
        <div class="page__content rich-text__text rte text-subtext page-review-reward__content--mobile">
          {{ page.content }}
        </div>
      {% endif %}
    </div>
  </div>
</div>
<div id="review-popup" class="review-popup">
  <div class="review-popup__overlay"></div>
  <div class="review-popup__content">
    <button class="review-popup__close">&times;</button>
    <iframe id="review-iframe" src=""></iframe>
  </div>
</div>


{% schema %}
{
  "name": "Page review and reward",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "checkbox",
      "id": "enable_review_buttons",
      "label": "Show Review Buttons",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_cw",
      "label": "Image CW"
    },
    {
      "type": "url",
      "id": "link_cw",
      "label": "Link CW"
    },
    {
      "type": "image_picker",
      "id": "image_shopify",
      "label": "Image Shopify"
    },
    {
      "type": "url",
      "id": "link_shopify",
      "label": "Link Shopify"
    },
    {
      "type": "image_picker",
      "id": "image_aws",
      "label": "Image AWS"
    },
    {
      "type": "url",
      "id": "link_aws",
      "label": "Link AWS"
    }
  ],
  "presets": [
    {
      "name": "Page review and reward"
    }
  ]
}
{% endschema %}
