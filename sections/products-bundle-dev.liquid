<style>
  /* Desktop styles (min-width: 768px) */
  @media screen and (min-width: 768px) {
    .section-products-bundle-dev .section__content-bundle {
      display: grid;
      grid-template-columns: 1fr 1fr auto; /* sản phẩm - bundle - banner */
      gap: 2rem;
      align-items: stretch;
    }
  
    {% comment %} /* Nội dung bên trong cũng giãn đều để cột luôn full height */
  .section-products-bundle-dev .bundle-layout__products > *,
  .section-products-bundle-dev .bundle-layout__sidebar > * {
    flex: 1 1 auto;
  } {% endcomment %}
   .section-products-bundle-dev .bundle-layout {
    display: flex;
    flex: 1;
    align-items: stretch;
  }

    /* Banner position right */
    .banner-position-right {
      grid-template-areas: 'main banner';
    }

    /* Banner position left */
    .banner-position-left {
      grid-template-areas: 'banner main';
    }

    .bundle-layout__banner {
      grid-area: banner;
    }
    .section-products-bundle-dev .featured-collection__items{
      border-radius: 12px;
      border: 1px solid;
      padding: 3rem 2.4rem 2.4rem 2.4rem;
    }

   .section-products-bundle-dev .bundle-layout__products {
      width: 60%;
    }
  }
  /* lương sửa phần selection product bundle cho mobile khớp với giao diện */
  @media (max-width: 1023.98px) {
    /* Fix pseudo-element gradient không tràn */
    .section-products-bundle-dev .products-bundle-selection__bar-column:before,
    .section-products-bundle-dev .products-bundle-selection__bar-column:has(details[aria-expanded='false']):before {
      left: 0 !important;
      width: 100% !important;
    }

    /* Giới hạn width của thanh swipe để không tràn */
    .section-products-bundle-dev .products-bundle-selection__bar-list-wrap .swipe-mobile {
      width: 100% !important;
      max-width: 100% !important;
      overflow-x: auto;
    }

    /* Ngăn item width tính theo 100vw */
    .section-products-bundle-dev .products-bundle-selection__bar-list-wrap .swipe-mobile {
      --swipe-item-width: clamp(6rem, calc((100% - 4rem) / 5), 10rem) !important;
    }
    /* Thêm khoảng cách giữa các item trong bar mobile */
    .section-products-bundle-dev .products-bundle-selection__bar-list {
      display: flex !important;
      gap: 0.8rem !important; /* hoặc 1rem tùy ý */
      padding: 0.4rem 0; /* thêm khoảng trống trên dưới */
    }

    /* Đảm bảo item không dính sát nhau */
    .section-products-bundle-dev .products-bundle-selection__bar-item {
      flex: 0 0 auto; /* giữ kích thước cố định */
    }
  }
</style>

