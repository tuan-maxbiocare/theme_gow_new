<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>
<div class="page-width page-width--{{ section.settings.container }} section--padding">
  <div class="rich-text rich-text--standard">
    <h2 class="page__title h1 rich-text__heading text-{{ section.settings.text_alignment }}">
      <motion-element class="inline-flex" data-motion="fade-up">
        {{ page.title | escape }}
      </motion-element>
    </h2>

    <input type="file" id="upload" multiple accept="image/*">
<div id="preview"></div>

<script>
document.getElementById('upload').addEventListener('change', function(event) {
  const files = event.target.files;
  let previewArea = document.getElementById('preview');
  previewArea.innerHTML = ""; // clear previous images

  Array.from(files).forEach(file => {
    let img = document.createElement("img");
    img.src = URL.createObjectURL(file);
    img.style.maxWidth = "120px";
    img.style.margin = "5px";
    previewArea.appendChild(img);
  });
});
</script>





