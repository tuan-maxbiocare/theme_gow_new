    "tabs_content_yFQyJf": {
      "type": "tabs-content",
      "blocks": {
        "image_with_text_XXKmxa": {
          "type": "image_with_text",
          "settings": {
            "navigation_title": "About Little Étoile​",
            "image": "shopify://shop_images/Gow_saftytesting.webp",
            "desktop_image_position": "left",
            "image_aspect_ratio": "4/3",
            "heading": "CARING FOR EVERY STEP OF your LITTLE ONE’S journey",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h3",
            "subheading": "",
            "description": "<p>Little Étoile is committed to partnering with parents and families at every step of the way on their special journey, from conception, through to pregnancy and early life. Through our premium ranges of nutritional and topical care products, along with educational resources designed to instill an appreciation for family, nature, and the environment, we aim to provide a complete and comprehensive level of care to support physical, functional, and emotional development.</p>",
            "description_size": "text-base",
            "collapsible_heading": "Collapsible row",
            "collapsible_heading_size": "h4",
            "icon": "check",
            "page": "",
            "default_open": false,
            "table_html": "",
            "button_label": "",
            "button_link": "",
            "button_style": "btn--primary",
            "button_icon": "none"
          }
        },
        "image_with_text_7wK3nr": {
          "type": "image_with_text",
          "settings": {
            "navigation_title": "Quality First​",
            "image": "shopify://shop_images/LEN2_test.webp",
            "desktop_image_position": "right",
            "image_aspect_ratio": "adapt",
            "heading": "",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "hd2",
            "subheading": "",
            "description": "<p>1 level scoop = 8.5g of powder. 1 scoop of powder added to 50mL of water gives approximately 50mL of formula. Formula should be prepared just before feeding or refrigerated for use within 24 hours. Use only the enclosed scoop. NOTE: This is a recommendation only, as actual feeding levels will depend on your baby’s demands</p><h2>How to prepare</h2><ul><li>Wash your hands, bottle, cap and teat before use.</li><li>Sterilise bottle, teat, and cap by boiling for at least 5 minutes or using an approved steriliser.</li><li>Boil fresh drinking water for 5 minutes. Allow to cool to feeding temperature.</li><li>Consult the FEEDING GUIDE. Measure out the required amount of water into the sterilised bottle.</li><li>Using only the scoop provided, ﬁll the scoop with powder, level off using the built-in leveller. Do not compact powder. Always add 1 level scoop of powder for each 60mL of water.</li><li>After combining the powder and water, cap the bottle and shake until powder is completely dissolved.</li><li>Test temperature of the dissolved formula on wrist. Feed immediately.</li><li>Always prepare each bottle separately and freshly. Discard unfinished feed.</li></ul>",
            "description_size": "text-base",
            "collapsible_heading": "Collapsible row",
            "collapsible_heading_size": "h4",
            "icon": "check",
            "page": "",
            "default_open": false,
            "table_html": "<ul style=\"font-size: small;\">\n \t<li>Serving size: approximately 171mL per serve</li>\n \t<li>Servings per can: approximately 31 serves</li>\n</ul>\n<table class=\"gowTable\">\n<tbody>\n<tr>\n<th>Nutrients</th>\n<th>Average Quantity per Serve</th>\n<th>% RDI per serve</th>\n<th>Average Quantity per 100mL</th>\n</tr>\n<tr>\n\t<td>Energy</td>\n\t<td>529kJ</td>\n\t<td> </td>\n\t<td>309kJ</td>\n</tr>\n\n<tr>\n\t<td>Protein</td>\n\t<td>5.74g</td>\n\t<td> </td>\n\t<td>3.36g</td>\n</tr>\n<tr>\n\t<td>Fat, total\n\t\t<br>saturated\n\t\t<br>monounsaturated\n\t\t<br>polyunsaturated\n\t\t<br>omega-3:\n\t\t<br>α-Linolenic acid (ALA)\n\t\t<br>Docosahexaenoic acid (DHA)\n\t\t<br>Eicosapentaenoic acid (EPA)\n\t\t<br>omega-6:\n\t\t<br>Linolenic acid (LA)\n\t\t<br>trans</td>\n\t<td>\n    \t<br>5.87g\n\t\t<br>2.12g\n\t\t<br>2.27g\n\t\t<br><br>117mg\n        <br>20.0mg\n\t\t<br>5.13mg\n\t\t<br><br>1,060mg\n\t\t<br>0.04g</td>\n\t<td> </td>\n\t<td>\n    \t<br>3.43g\n\t\t<br>1.24g\n\t\t<br>1.33g\n\t\t<br><br>68.6mg\n        <br>11.7mg\n\t\t<br>3.00mg\n\t\t<br><br>620mg\n\t\t<br>0.02g</td>\n</tr>\n<tr>\n\t<td>Carbohydrate\n\t\t<br>sugars</td>\n\t<td>12.0g\n\t\t<br>12.0g</td>\n    <td> </td>\n\t<td>7.05g\n\t\t<br>7.05g</td>\n</tr>\n<tr>\n\t<td>Fibre (Prebiotics)\n    \t<br>Galactooligosaccharides (GOS)</td>\n\t<td>1.20g</td>\n\t<td> </td>\n\t<td>0.70g</td>\n</tr>\n<tr>\n\t<td class=\"bold\" colspan=\"4\">Vitamins</td>\n</tr>\n<tr>\n\t<td>Vitamin A</td>\n\t<td>105mcg RE</td>\n    <td>35</td>\n\t<td>61.4mcg RE</td>\n</tr>\n<tr>\n\t<td>Betacarotene</td>\n\t<td>47.7mcg RE</td>\n    <td> </td>\n\t<td>27.9mcg</td>\n</tr>\n<tr>\n\t<td>Vitamin B6</td>\n\t\t<td>120mcg</td>\n        <td>17</td>\n\t\t<td>70.0mcg</td>\n</tr>\n<tr>\n\t<td>Vitamin B12</td>\n\t<td>0.50mcg</td>\n    <td>50</td>\n\t<td>0.29mcg</td>\n</tr>\n<tr>\n\t<td>Vitamin C</td>\n\t<td>15.0mg</td>\n    <td>50</td>\n\t<td>8.77mg</td>\n</tr>\n<tr>\n\t<td>Vitamin D</td>\n\t<td>2.06mcg</td>\n    <td>41</td>\n\t<td>1.20mcg</td>\n</tr>\n<tr>\n\t<td>Vitamin E</td>\n\t<td>2.50mg α-TE</td>\n    <td>50</td>\n\t<td>1.46mg α-TE</td>\n</tr>\n<tr>\n\t<td>Vitamin K</td>\n\t<td>15.4mcg</td>\n    <td></td>\n\t<td>8.99mcg</td>\n</tr>\n<tr>\n\t<td>Biotin (vitamin H)</td>\n\t<td>9.64mcg</td>\n    <td> </td>\n\t<td>5.64mg</td>\n</tr>\n<tr>\n\t<td>Niacin (vitamin B3)</td>\n\t<td>1.07mg</td>\n    <td>21</td>\n\t<td>0.62mg</td>\n</tr>\n<tr>\n\t<td>Folate</td>\n\t<td>18.8mcg</td>\n    <td>19</td>\n\t<td>11.0mcg</td>\n</tr>\n<tr>\n\t<td>Pantothenic acid</td>\n\t<td>0.89mg</td>\n    <td> </td>\n\t<td>0.52mg</td>\n</tr>\n<tr>\n\t<td>Riboflavin (vitamin B2)</td>\n\t<td>278mcg</td>\n    <td>35</td>\n\t<td>163mcg</td>\n</tr>\n<tr>\n\t<td>Thiamin (vitamin B1)</td>\n\t<td>145mcg</td>\n    <td>29</td>\n\t<td>85.0mcg</td>\n</tr>\n<tr>\n\t<td class=\"bold\" colspan=\"4\">Minerals</td>\n</tr>\n<tr>\n\t<td>Calcium</td>\n\t<td>159mg</td>\n    <td>23</td>\n\t<td>93.2mg</td>\n</tr>\n<tr>\n\t<td>Phosphorus</td>\n\t<td>106mg</td>\n    <td>21</td>\n\t<td>62.0mg</td>\n</tr>\n<tr>\n\t<td>Copper</td>\n\t<td>77.5mcg</td>\n    <td> </td>\n\t<td>45.3mcg</td>\n</tr>\n<tr>\n\t<td>Iodine</td>\n\t<td>33.0mcg</td>\n    <td>47</td>\n\t<td>19.3mcg</td>\n</tr>\n<tr>\n\t<td>Iron</td>\n\t<td>1.91mg</td>\n    <td>32</td>\n\t<td>1.12mg</td>\n</tr>\n<tr>\n\t<td>Magnesium</td>\n\t<td>13.8mg</td>\n    <td>17</td>\n\t<td>8.05mg</td>\n</tr>\n<tr>\n\t<td>Manganese</td>\n\t<td>76.5mcg</td>\n    <td> </td>\n\t<td>44.7mcg</td>\n</tr>\n<tr>\n\t<td>Selenium</td>\n\t<td>6.64mcg</td>\n    <td> </td>\n\t<td>3.88mcg</td>\n</tr>\n<tr>\n\t<td>Zinc</td>\n\t<td>1.10mg</td>\n    <td>24</td>\n\t<td>0.64mg</td>\n</tr>\n<tr>\n\t<td>Chloride</td>\n\t<td>153mg</td>\n    <td> </td>\n\t<td>89.2mg</td>\n</tr>\n<tr>\n\t<td>Potassium</td>\n\t<td>235mg</td>\n    \n    <td> </td>\n\t<td>137mg</td>\n</tr>\n<tr>\n\t<td>Sodium</td>\n\t<td>48.5mg</td>\n    <td> </td>\n\t<td>28.3mg</td>\n</tr>\n<tr>\n\t<td class=\"bold\" colspan=\"4\">Others</td>\n</tr>\n<tr>\n\t<td>Lactoferrin</td>\n\t<td>10.0mg</td>\n    <td> </td>\n\t<td>5.85mg</td>\n</tr>\n<tr>\n\t<td>Beta-glucan*</td>\n\t<td>8.75mg</td>\n    <td> </td>\n\t<td>5.12mg</td>\n</tr>\n<tr>\n\t<td>Lutein</td>\n\t<td>50.0mcg</td>\n    <td> </td>\n\t<td>29.2mcg</td>\n</tr>\n<tr>\n\t<td>Taurine</td>\n\t<td>9.21mg</td>\n    <td> </td>\n\t<td>5.39mg</td>\n</tr>\n<tr>\n\t<td>Choline</td>\n\t<td>30.9mg</td>\n    <td> </td>\n\t<td>18.0mg</td>\n</tr>\n<tr>\n\t<td>Carnitine</td>\n\t<td>3.06mg</td>\n    <td> </td>\n\t<td>1.79mg</td>\n</tr>\n</tbody>\n</table>\n<p>% RDI = % Recommended Daily Intake for Children aged 1-3 years</p>",
