_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h2"}},"text_fDmTfc":{"type":"text","settings":{"text":"<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.<\/p>","subtext_color":true}}},"block_order":["badge_eCffqH","subheading_LQeCEY","heading_gP4tNn","text_fDmTfc"],"name":"t:sections.image-with-text.name","settings":{"container":"fixed","color_scheme":"scheme-11","image":"shopify:\/\/shop_images\/GoWshop_cowmilk_d2e9328f-6317-452d-a858-b7e78f2be1cf.webp","image_position":"right","image_width":60,"desktop_content_position":"center","desktop_content_alignment":"left","mobile_content_alignment":"inherit","show_section_divider":false,"divider_width":"fixed","padding_top":50,"padding_bottom":50}},"collapsible_tabs_W9T4Cf":{"type":"collapsible-tabs","blocks":{"collapsible_item_3KeDE8":{"type":"collapsible_item","settings":{"icon":"leaf","heading":"FULL INGREDIENTS LIST","content":"<p>Cyclopentasiloxane & Dimethiconol, Cyclohexasiloxane & Cyclopentasiloxane, Capric\/Caprylic Triglyceride, Tocopherol, Carthamus tinctorius Seed Oil, Avena sativa Kernel Oil, Argania spinosa Kernel Oil, Prunus armeniaca Kernel Oil, Vitis vinifera Seed Oil, Parfum.<\/p><ul><li><strong>Safflower oil<\/strong> – high in linoleic acid, which nourishes scalp and hair follicles (Skolnik, 1977)<\/li><li><strong>Argan oil<\/strong> – shown to protect hair like a barrier from free radical damage (Shafiri, 2023)<\/li><li><strong>Apricot seed oil<\/strong> – a natural source of sterols and squalene that support delicate skin’s natural oil production (Rudzinska, 2017)<\/li><li><strong>Grape seed oil<\/strong> – antioxidant, antibacterial, helps reduce irritation (Khanna, 2002) and very good at restoring hair smoothness (Demir, 2023)<\/li><li><strong>Tocopherols<\/strong> – natural plant forms of vitamin E that protect against free-radical damage, which occurs in dry or inflamed skin (Michalak, 2022)<\/li><\/ul><p><em>The composition of our products may be updated periodically. For the most current ingredient information, we advise checking the ingredient list on the product packaging that you receive, which will always reflect the latest updates.<\/em><\/p>","custom_liquid":"","page":"","open":false,"use_subtext_color":false}}},"block_order":["collapsible_item_3KeDE8"],"disabled":true,"name":"t:sections.collapsible-tabs.name","settings":{"container":"fixed","color_scheme":"scheme-11","header_layout":"vertical","section_header_alignment":"left","section_header_alignment_mobile":"inherit","subheading":"","heading":"INGREDIENTS","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h1","description":"","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--primary","button_icon":"none","column_gap":"large","row_gap":"inherit","item_style":"standard","item_color_scheme":"","item_heading_font":"heading","item_heading_size":"h4","item_icon_size":"extra-large","padding_top":50,"padding_bottom":30,"show_section_divider":false,"divider_width":"fixed"}},"tabs_content_RkDDtF":{"type":"tabs-content","blocks":{"image_with_text_qVGB9J":{"type":"image_with_text","settings":{"navigation_title":"Ingredients","image":"shopify:\/\/shop_images\/LEN2_test.webp","desktop_image_position":"left","image_aspect_ratio":"adapt","heading":"","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"hd2","subheading":"","description":"<p><strong>Ingredients:<\/strong> Skim Milk Solids, Lactose, Vegetable Oil Blend (Soy, Palm Olein, High Oleic Sunflower, Coconut), Galactooligosaccharides (GOS) containing Lactose, Whey Protein Concentrate, Demineralised Whey Powder, Docosahexaenoic Acid (DHA) Powder from Fish Oil, Emulsifier (Soy Lecithin), Choline Chloride, Taurine, L-Carnitine, Wellmune® (containing 75% of Beta-glucan)*, Lactoferrin, Lutein.<\/p><p><strong>Minerals:<\/strong> Potassium Chloride, Magnesium Chloride, Ferrous Sulphate, Calcium Carbonate, Di-Potassium Hydrogen Orthophosphate, Calcium Hydrogen Orthophosphate, Sodium Chloride, Tri-Potassium Citrate, Tri-Sodium Citrate, Zinc Sulphate, Copper Sulphate, Manganese Sulphate, Potassium Iodide, Sodium Selenite.<\/p><p><strong>Vitamins:<\/strong> Ascorbic Acid, DL-alpha-Tocopheryl Acetate, Riboflavin-5’-Phosphate Sodium, Vitamin A Acetate, Niacinamide, Cholecalciferol, Calcium Pantothenate, Cyanocobalamin, Phytonadione, Thiamine Hydrochloride, Pyridoxine Hydrochloride, Folic Acid, D-Biotin, Beta Carotene.<\/p><p>Protein source: from cow’s milk. Contains Milk, Soy and Fish.<br\/>*Wellmune® is a registered trademark of Kerry Group<\/p>","description_size":"text-base","enable_collapsible":true,"collapsible_heading":"Collapsible row","collapsible_heading_size":"h4","icon":"check","page":"","default_open":false,"table_html":"","button_label":"","button_link":"","button_style":"btn--primary","button_icon":"none"}},"image_with_text_VGmPKf":{"type":"image_with_text","settings":{"navigation_title":"Nutritional Values","image":"shopify:\/\/shop_images\/LEN2_test.webp","desktop_image_position":"right","image_aspect_ratio":"adapt","heading":"","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"hd2","subheading":"","description":"<p>1 level scoop = 8.5g of powder. 1 scoop of powder added to 50mL of water gives approximately 50mL of formula. Formula should be prepared just before feeding or refrigerated for use within 24 hours. Use only the enclosed scoop. NOTE: This is a recommendation only, as actual feeding levels will depend on your baby’s demands<\/p><h2>How to prepare<\/h2><ul><li>Wash your hands, bottle, cap and teat before use.<\/li><li>Sterilise bottle, teat, and cap by boiling for at least 5 minutes or using an approved steriliser.<\/li><li>Boil fresh drinking water for 5 minutes. Allow to cool to feeding temperature.<\/li><li>Consult the FEEDING GUIDE. Measure out the required amount of water into the sterilised bottle.<\/li><li>Using only the scoop provided, ﬁll the scoop with powder, level off using the built-in leveller. Do not compact powder. Always add 1 level scoop of powder for each 60mL of water.<\/li><li>After combining the powder and water, cap the bottle and shake until powder is completely dissolved.<\/li><li>Test temperature of the dissolved formula on wrist. Feed immediately.<\/li><li>Always prepare each bottle separately and freshly. Discard unfinished feed.<\/li><\/ul>","description_size":"text-base","enable_collapsible":true,"collapsible_heading":"Collapsible row","collapsible_heading_size":"h4","icon":"check","page":"","default_open":false,"table_html":"","button_label":"","button_link":"","button_style":"btn--primary","button_icon":"none"}},"image_with_text_arXxcz":{"type":"image_with_text","settings":{"navigation_title":"Instructions for Use","image":"shopify:\/\/shop_images\/LEN2_test.webp","desktop_image_position":"left","image_aspect_ratio":"adapt","heading":"","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"hd2","subheading":"","description":"<p>1 level scoop = 8.5g of powder. 1 scoop of powder added to 50mL of water gives approximately 50mL of formula. Formula should be prepared just before feeding or refrigerated for use within 24 hours. Use only the enclosed scoop. NOTE: This is a recommendation only, as actual feeding levels will depend on your baby’s demands<\/p><h2>How to prepare<\/h2><ul><li>Wash your hands, bottle, cap and teat before use.<\/li><li>Sterilise bottle, teat, and cap by boiling for at least 5 minutes or using an approved steriliser.<\/li><li>Boil fresh drinking water for 5 minutes. Allow to cool to feeding temperature.<\/li><li>Consult the FEEDING GUIDE. Measure out the required amount of water into the sterilised bottle.<\/li><li>Using only the scoop provided, ﬁll the scoop with powder, level off using the built-in leveller. Do not compact powder. Always add 1 level scoop of powder for each 60mL of water.<\/li><li>After combining the powder and water, cap the bottle and shake until powder is completely dissolved.<\/li><li>Test temperature of the dissolved formula on wrist. Feed immediately.<\/li><li>Always prepare each bottle separately and freshly. Discard unfinished feed.<\/li><\/ul>","description_size":"text-base","enable_collapsible":true,"collapsible_heading":"Collapsible row","collapsible_heading_size":"h4","icon":"check","page":"","default_open":false,"table_html":"","button_label":"","button_link":"","button_style":"btn--primary","button_icon":"none"}},"tab_7hKyyb":{"type":"tab","settings":{"navigation_title":"Storage","tab_content":"<p>Fill in the text content of the collapsible item here. You can provide details and explanation for the question here.<\/p>","custom_liquid":"","tab_page":"","enable_collapsible_tab":true,"collapsible_heading":"Collapsible row","collapsible_heading_size":"h4","icon":"check","page":"","default_open":false,"table_html":""}}},"block_order":["image_with_text_qVGB9J","image_with_text_VGmPKf","image_with_text_arXxcz","tab_7hKyyb"],"name":"t:sections.tabs-content.name","settings":{"container":"fixed","color_scheme":"scheme-1","navigation_style":"buttons","navigation_alignment":"center","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed","show_pagination":false,"enable_collapsible_all":false,"section_header_alignment":"left","section_header_alignment_mobile":"inherit","subheading":"","heading":"Multicolumn","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h1","description":"","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--underline"