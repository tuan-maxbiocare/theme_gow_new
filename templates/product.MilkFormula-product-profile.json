<li>Consult the FEEDING GUIDE. Measure out the required amount of water into the sterilised bottle.<\/li><li>Using only the scoop provided, ﬁll the scoop with powder, level off using the built-in leveller. Do not compact powder. Always add 1 level scoop of powder for each 60mL of water.<\/li><li>After combining the powder and water, cap the bottle and shake until powder is completely dissolved.<\/li><li>Test temperature of the dissolved formula on wrist. Feed immediately.<\/li><li>Always prepare each bottle separately and freshly. Discard unfinished feed.<\/li><\/ul>","custom_liquid":"","page":"","open":false,"use_subtext_color":false}},"collapsible_item_GXaPtX":{"type":"collapsible_item","settings":{"icon":"none","heading":"Storage","content":"<p>Fill in the text content of the collapsible item here. You can provide details and explanation for the question here.<\/p>","custom_liquid":"","page":"","open":false,"use_subtext_color":false}}},"block_order":["image_card_rTNXXm","collapsible_item_AqU9Xq","collapsible_item_bFJ3yp","collapsible_item_aEXhWV","collapsible_item_GXaPtX"],"disabled":true,"name":"t:sections.collapsible-tabs.name","settings":{"container":"fixed","color_scheme":"scheme-7","header_layout":"vertical","section_header_alignment":"left","section_header_alignment_mobile":"inherit","subheading":"","heading":"Collapsible tabs","highlight_style":"none","highlight_font_style":"italic","highlight_style_color":"","highlight_text_color":"","heading_size":"h1","description":"","text_size":"text-base","button_label":"","button_link":"","button_style":"btn--primary","button_icon":"none","column_gap":"large","row_gap":"inherit","item_style":"card","item_color_scheme":"","item_heading_font":"heading","item_heading_size":"h4","item_icon_size":"extra-large","padding_top":50,"padding_bottom":50,"show_section_divider":false,"divider_width":"fixed"}},"favorite_products_V7Bxdk":{"type":"favorite-products","blocks":{"product_KxeKUL":{"type":"product","settings":{"color_sch