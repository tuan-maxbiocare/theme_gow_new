      "blocks": {
        "image_with_text_zJ9Qmg": {
          "type": "image_with_text",
          "settings": {
            "navigation_title": "About Max Biocare​",
            "image": "shopify://shop_images/Salvarity_sustain_test.webp",
            "desktop_image_position": "left",
            "image_aspect_ratio": "1/1",
            "heading": "Trusted Australian brand for more than 25 years",
