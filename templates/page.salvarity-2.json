        "tab_f7kfRF": {
          "type": "tab",
          "settings": {
            "navigation_title": "Clean Swap List",
            "tab_content": "<h4><strong>Clean Swap Strategy​</strong></h4><p>We swap out common ingredients used in skincare, for planet and skin friendly alternatives. We prioritise low-footprint, sustainably sourced ingredients that completely biodegrade, minimizing residues to our waterways. ​​</p>",
            "custom_liquid": "",
            "tab_page": "",
            "enable_collapsible_tab": false,
