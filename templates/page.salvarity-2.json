            "highlight_font_style_3": "italic",
            "highlight_style_color_3": "",
            "highlight_text_color_3": "",
            "heading_size_3": "h3",
            "text_3": "<p><strong>Seriously Safe Skincare<br/></strong>Every Salvarity formula is tested for safety, quality, and real results - just like our pharma-grade products. Proven effective. Safe for sensitive skin.</p>",
            "text_size_3": "text-sm",
            "button_label_3": "",
            "button_link_3": "",
