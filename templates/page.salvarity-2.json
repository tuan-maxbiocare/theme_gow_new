            "highlight_font_style_2": "italic",
            "highlight_style_color_2": "",
            "highlight_text_color_2": "",
            "heading_size_2": "h3",
            "text_2": "<p><strong>Kind by Nature<br/></strong>We create skincare that's gentle on skin and the planet. Every formula is tested for biodegradability because what's good for you should be good for the world too.</p>",
            "text_size_2": "text-sm",
