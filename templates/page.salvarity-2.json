        "multicolumn_rgEdw4": {
          "type": "multicolumn",
          "settings": {
            "navigation_title": "Our Ethos (EKS)​",
            "image_max_width": 200,
            "image_1": "shopify://shop_images/EKS_LOGO_E_1000x1000_004adfd3-5fe1-499b-886b-b83fdf2361b4.webp",
            "title_1": "EFFECTIVE",
            "highlight_style_1": "none",
            "highlight_font_style_1": "italic",
            "highlight_style_color_1": "",
            "highlight_text_color_1": "",
            "heading_size_1": "h3",
            "text_1": "<p><strong>Backed by Science, Not Hype<br/></strong>We clinically test every formula to make sure it works - no fluff, no filters. Want proof? Check out how our bestsellers perform.</p>",
            "text_size_1": "text-sm",
