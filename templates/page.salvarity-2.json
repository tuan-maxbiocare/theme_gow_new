            "desktop_image_position": "left",
            "image_aspect_ratio": "1/1",
            "heading": "Real Skincare for Real Teen Skin",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h2",
            "subheading": "Salvarity® Purpose",
            "description": "<p>Salvarity is age-appropriate skincare made for the realities of teen skin. Our formulas are gentle, effective, and designed to support hormonal changes, undo the impact of harsh products, and protect against everyday stressors like pollution and late nights.</p>",
            "description_size": "text-base",
            "enable_collapsible": true,
