/* card-product.liquid */
.product-card-custom {
    background: #fff;
    border: 1px solid {{ settings.border_product_card_custom}};
    border-radius: 12px;
    padding: 16px;
    transition: border-color 0.4s ease;
}

.product-card-custom:hover {
    border-color: {{ settings.border_product_card_custom_hover }};
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

.product-card__title {
    display: inline-block;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: normal;
    line-height: 1.4em;
    min-height: calc(1.4em * 2);
    max-height: calc(1.4em * 2);
}

.button-add-cart-custom {
    margin-top : 10px;
}


@media (max-width: 767.98px) {
  .product-card__action-button {
    padding: 0;
    width: 100% !important;
    line-height: 1;
    border-radius: var(--buttons-radius, 0);
  }
   .product-card__action-text {
    position: relative;
    max-width: 100%;
  }
}

/* price.liquid */
.f-price__regular-custom {
    font-size: {{ settings.pcard_title_font_size }}rem;
}

.f-price-item--sale {
    font-size: {{ settings.f_price_item_sale}}rem;
}


/* menu-food-product-card */
.menu-food-product-card .f-price-item--sale {
    font-size: 1.8rem !important;
}


.menu-food-product-card .f-price__regular-custom {
    font-size: 1.8rem !important;
}

.menu-food-product-card .f-price-item--regular-compare-at-price{
    font-size: 1rem;
}

/* .menu-sidebar */
.menu-sidebar {
    --toggle-width: 28rem;
}

/* custom section-ingredients */
.section-ingredients .testimonial__inner {
    display: flex;
    align-items: center;
}

/* section-quick-comparison-table */
.quick-comparison-table th,
.quick-comparison-table td {
  padding: 10px !important;
}

.quick-comparison-table th:first-child,
.quick-comparison-table td:first-child {
  width: 24rem !important;
}