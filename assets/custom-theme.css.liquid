/* card-product.liquid */
.product-card-custom {
    background: #fff;
    border: 1px solid {{ settings.border_product_card_custom}};
    border-radius: 12px;
    padding: 16px;
    transition: border-color 0.4s ease;
}

.product-card-custom:hover {
    /* border-color: {{ settings.border_product_card_custom_hover }};
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08); */
}

.product-card__title {
    display: inline-block;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: normal;
    line-height: 1.4em;
    min-height: calc(1.4em * 2);
    max-height: calc(1.4em * 2);
}

.button-add-cart-custom {
    margin-top : 10px;
}

.mega-menu__column-logo-brand-custom .mega-menu__column {
  padding-inline : 1rem;
}

.mega-menu__list.menu-logo-brand .mega-menu__column:first-child {
  padding-inline-start: 5px;
}
.mega-menu__list.menu-logo-brand .mega-menu__column {
  padding-block-start: 4rem;
  padding-inline: 0.5rem;
}


/* overwrite */
.product-card-style-card {
  height: auto;
}

.product-card-style-card .product-card__info {
  padding: 1.2rem 0 0;
}

@media (min-width: 768px) {
  .product-card-style-card .product-card__info {
    padding: 1.2rem 0 0;
  }
}


@media (max-width: 767.98px) {
  .product-card__action-button {
    padding: 0;
    width: 100% !important;
    line-height: 1;
    border-radius: var(--buttons-radius, 0);
  }
   .product-card__action-text {
    position: relative;
    max-width: 100%;
  }
  .product-card-custom {
    padding: 8px;
  }
  .product-card__atc.product-card__action-button.btn{
    font-size: 1.4rem !important;
  }
  .f-price-item--sale{
    font-size: 2rem;
  }
}

/* price.liquid */
.product-card .f-price__regular-custom,
.sticky-atc-bar__product-info .f-price__regular-custom {
    font-size: {{ settings.pcard_title_font_size }}rem;
}

.product-card .f-price-item--sale,
.sticky-atc-bar__product-info .f-price-item--sale {
    font-size: {{ settings.f_price_item_sale}}rem;
}

.product-card__atc.product-card__action-button.btn {
 font-size: {{ settings.f_add_to_card }}rem;
 text-transform: uppercase;
}

/* menu-food-product-card */
.menu-food-product-card .f-price-item--sale {
    font-size: 1.8rem !important;
}


.menu-food-product-card .f-price__regular-custom {
    font-size: 1.8rem !important;
}

.menu-food-product-card .f-price-item--regular-compare-at-price{
    font-size: 1rem;
}

/* .menu-sidebar */
.menu-sidebar {
    --toggle-width: 28rem;
}

