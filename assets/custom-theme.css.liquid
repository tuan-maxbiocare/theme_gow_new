/* card-product.liquid */
.product-card-custom {
    background: #fff;
    border: 1px solid {{ settings.border_product_card_custom}};
    border-radius: 12px;
    padding: 16px;
    transition: border-color 0.4s ease;
}

.product-card-custom:hover {
    border-color: {{ settings.border_product_card_custom_hover }};
}

.product-card__title .reversed-link__text {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: normal;
    line-height: 1.4em;
    min-height: calc(1.4em * 2);
    max-height: calc(1.4em * 2);
}


@media (max-width: 767.98px) {
  .product-card__action-button {
    padding: 0;
    width: 100% !important;
    line-height: 1;
     border-radius: 6px;
  }
   .product-card__action-text {
    position: relative;
    max-width: 100%;
  }
}

/* price.liquid */
.f-price__regular-custom {
    font-size: {{ settings.pcard_title_font_size }}rem;
}

.f-price-item--sale {
    font-size: {{ settings.f_price_item_sale}}rem;
}