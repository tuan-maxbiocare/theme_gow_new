{% comment %}
======================================================
POP-UP BƯỚC 3: EXIT CONFIRM – STYLE & LOGIC ĐỒNG BỘ POPUP 2
======================================================
{% endcomment %}
{%- liquid
    assign modal_id_3 = 'popupStep3'
    assign green_color = '#6aaa64'
    assign text_color = '#ffffff'
    assign overlay_bg_3 = 'rgba(0, 0, 0, 0.5)'
-%}

<style>
  #{{ modal_id_3 }} {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 999;
      display: flex;
      justify-content: center;
      align-items: center;
      animation: fadeIn 0.3s ease-in-out;
      background-color: {{ overlay_bg }};
  }

  @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
  }

  .popup-step3-container {
      background: white;
      border-radius: 8px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      width: 90%;
      max-width: 800px;
      position: relative;
      overflow: hidden;
      text-align: center;
      animation: scaleIn 0.25s ease-in-out;
  }

  @keyframes scaleIn {
      from { transform: scale(0.9); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
  }

  .step3-close-btn {
      position: absolute;
      top: 10px;
      right: 10px;
      background: white;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 20px;
      font-weight: bold;
      color: #333;
      cursor: pointer;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      transition: 0.2s;
      z-index: 999;
  }

  .step3-close-btn:hover {
      transform: scale(1.05);
  }

  .step3-header {
      background-color: #1CA758;
      padding: 20px 10px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      color: {{ text_color }};
      gap: 10px;
  }

  .step3-icon-item {
      flex: 1;
      font-size: 13px;
      line-height: 1.2;
  }

  .step3-icon {
      font-size: 24px;
      margin-bottom: 5px;
      display: block;
      line-height: 1;
  }

  .step3-body {
      padding: 40px 20px;
  }

  .step3-body p {
      font-size: 16px;
      color: #333;
      margin-bottom: 30px;
  }
  .popup-step3-container .btn--primary {
    background-color: #1CA758;
     border: 1px solid #1CA758;
  }
  .popup-step3-container .btn--primary:hover {
    background-color: #fff;
    color: #1CA758;
  }
</style>

<div id="{{ modal_id_3 }}">
    <div class="popup-step3-container">
        <span class="step3-close-btn">&times;</span>

        <div class="step3-header">
            <div class="step3-icon-item">
                <span style="margin-top:12px ; margin-bottom:12px" class="step3-icon"><img class="feature-icon-img" src="https://cdn.shopify.com/s/files/1/0677/1900/4417/files/icon-popup-new-register-1.png?v=1760927952"></span>
                <span>EXTRA 15% OFF</span>
            </div>
            <div class="step3-icon-item">
                <span class="step3-icon"><img class="feature-icon-img" src="https://cdn.shopify.com/s/files/1/0677/1900/4417/files/icon-popup-new-register-2.png?v=1761009432"></span>
                FREE SHIPPING
            </div>
            <div class="step3-icon-item">
                <span class="step3-icon"><img class="feature-icon-img" src="https://cdn.shopify.com/s/files/1/0677/1900/4417/files/icon-popup-new-register-3.png?v=1761009431"></span>
                FREE RETURNS
            </div>
        </div>

        <div class="step3-body">
            <p>
                New users will receive the above benefits!<br>
                <strong>Are you sure you want to leave?</strong>
            </p>

            <button class="btn btn--primary step3-continue-btn" type="submit">
          <span class="btn__text">Continue to register</span>
        </button>

{% comment %} 
            <a href="#" class="step3-continue-btn">Continue to register</a> {% endcomment %}
        </div>
    </div>
</div>
