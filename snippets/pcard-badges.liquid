{%- liquid
  if selected_variant
    assign target_variant = selected_variant
  else
    assign target_variant = product.selected_or_first_available_variant
  endif
  assign compare_at_price = selected_variant.compare_at_price
  assign price = selected_variant.price
  assign on_sale = false
  assign badge_style = settings.badges_corner_radius
  assign badge_position = settings.badges_position
  assign tag_badge_position = settings.tag_badges_position | default: badge_position
  if compare_at_price > price
    assign on_sale = true
  endif

  assign show_soldout = settings.pcard_show_badge_soldout
  assign show_on_sale_badge = settings.pcard_show_sale_badge

  unless on_sale
    assign show_on_sale_badge = false
  endunless
-%}
{%- if product.available == false or on_sale or product.tags.size > 0 -%}
  <div class="product-card__badge">
    {%- if product.available == false and show_soldout -%}
      {%- if badge_style == 'circle' -%}
        <span
          class="f-badge f-badge--soldout badge-circle badge-position--{{ badge_position }}"
          aria-hidden="true"
        >
          <span>Sold</span>
          <span>Out</span>
        </span>
      {%- else -%}
        <span
          class="f-badge f-badge--soldout badge-{{ badge_style }} badge-position--{{ badge_position }}"
          aria-hidden="true"
        >
          {{- 'products.product.sold_out' | t -}}
        </span>
      {%- endif -%}
    {%- endif -%}
    {%- if show_on_sale_badge and product.available -%}
      {%- liquid
        assign sale_badge = ''
        assign amount = 0
      -%}

      {%- case settings.pcard_sale_badge_type -%}
        {%- when 'show_percentage' -%}
          {%- if compare_at_price > price -%}
            {%- assign amount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price | round -%}
          {%- endif -%}

          {%- if badge_style == 'circle' -%}
            <span class="f-badge f-badge--sale badge-circle badge-position--{{ badge_position }}" aria-hidden="true">
              <span>{{ amount }}%</span>
              <span>OFF</span>
            </span>
          {%- else -%}
            <span
              class="f-badge f-badge--sale badge-{{ badge_style }} badge-position--{{ badge_position }}"
              aria-hidden="true"
            >
              {{ amount }}% OFF
            </span>
          {%- endif -%}

        {%- when 'show_amount' -%}
          {%- if compare_at_price > price -%}
            {%- assign amount = compare_at_price | minus: price | money -%}
          {%- endif -%}
          <span
            class="f-badge f-badge--sale badge-{{ badge_style }} badge-position--{{ badge_position }}"
            aria-hidden="true"
          >
            {{ 'products.product.price.save_price_html' | t: amount: amount }}
          </span>

        {%- else -%}
          <span
            class="f-badge f-badge--sale badge-{{ badge_style }} badge-position--{{ badge_position }}"
            aria-hidden="true"
          >
            {{ 'products.product.on_sale' | t }}
          </span>
      {%- endcase -%}
    {%- endif -%}
    {%- liquid
      assign new_tags_list = settings.product_new_tags | newline_to_br | strip_newlines | split: '<br />'
      assign hot_tags_list = settings.product_hot_tags | newline_to_br | strip_newlines | split: '<br />'
      assign coming_tags_list = settings.product_coming_tags | newline_to_br | strip_newlines | split: '<br />'
    -%}
    {%- for tag in product.tags -%}
      {%- liquid
        assign tag_handle = tag | handle
        assign badge_type = ''

        for item in new_tags_list
          assign item_handle = item | handle
          if tag_handle == item_handle
            assign badge_type = 'new'
            break
          endif
        endfor

        for item in hot_tags_list
          assign item_handle = item | handle
          if tag_handle == item_handle
            assign badge_type = 'hot'
            break
          endif
        endfor

        for item in coming_tags_list
          assign item_handle = item | handle
          if tag_handle == item_handle
            assign badge_type = 'coming'
            break
          endif
        endfor

        if badge_type == blank
          continue
        endif
      -%}
      <span class="f-badge f-badge--{{ badge_type }} badge-position--{{ tag_badge_position }}">{{ tag }}</span>
    {%- endfor -%}
  </div>
{%- endif -%}

<style>
    /* .f-badge--new,
    .f-badge--hot,
    .f-badge--coming {
      top: auto;
      left: auto;
      right: auto;
      bottom: auto;
    }

    .f-badge--sale,
    .f-badge--soldout {
      top: auto;
      left: auto;
      right: auto;
      bottom: auto;
    } */

    .product-card__badge:not(:has(.f-badge--new, .f-badge--hot, .f-badge--coming)) .f-badge--sale,
    .product-card__badge:not(:has(.f-badge--new, .f-badge--hot, .f-badge--coming)) .f-badge--soldout {
      top: 1.5rem;
      left: auto;
      right: 1.5rem;
      bottom: auto;
    }

    /* .f-badge--new,
    .f-badge--hot,
    .f-badge--coming {
      position: absolute;
      z-index: 2;
    }

    .f-badge--sale,
    .f-badge--soldout {
      position: absolute;
      z-index: 1;
    } */

    /* Offset for multiple badges at same position */
    .badge-position--top-right.f-badge--new,
    .badge-position--top-right.f-badge--hot,
    .badge-position--top-right.f-badge--coming {
      top: 0;
      right: 1.5rem;
    }

    .badge-position--top-right.f-badge--sale,
    .badge-position--top-right.f-badge--soldout {
      top: 3rem; /* Offset below tag badge */
      right: 1.5rem;
    }

    /* If no tag badges, move sale/soldout to tag position */
    .product-card__badge:not(:has(.f-badge--new, .f-badge--hot, .f-badge--coming)) .badge-position--top-right.f-badge--sale,
    .product-card__badge:not(:has(.f-badge--new, .f-badge--hot, .f-badge--coming)) .badge-position--top-right.f-badge--soldout {
      top: 0;
    }

    .badge-position--top-left.f-badge--new,
    .badge-position--top-left.f-badge--hot,
    .badge-position--top-left.f-badge--coming {
      top: 1.5rem;
      left: 1.5rem;
    }

    .badge-position--top-left.f-badge--sale,
    .badge-position--top-left.f-badge--soldout {
      top: 4.5rem;
      left: 1.5rem;
    }

    .product-card__badge:not(:has(.f-badge--new, .f-badge--hot, .f-badge--coming)) .badge-position--top-left.f-badge--sale,
    .product-card__badge:not(:has(.f-badge--new, .f-badge--hot, .f-badge--coming)) .badge-position--top-left.f-badge--soldout {
      top: 1.5rem;
    }

    .badge-position--bottom-right.f-badge--new,
    .badge-position--bottom-right.f-badge--hot,
    .badge-position--bottom-right.f-badge--coming {
      bottom: 3rem;
      right: 1.5rem;
    }

    .badge-position--bottom-right.f-badge--sale,
    .badge-position--bottom-right.f-badge--soldout {
      bottom: 1.5rem;
      right: 1.5rem;
    }

    .product-card__badge:not(:has(.f-badge--new, .f-badge--hot, .f-badge--coming)) .badge-position--bottom-right.f-badge--sale,
    .product-card__badge:not(:has(.f-badge--new, .f-badge--hot, .f-badge--coming)) .badge-position--bottom-right.f-badge--soldout {
      bottom: 3rem;
    }

    .badge-position--bottom-left.f-badge--new,
    .badge-position--bottom-left.f-badge--hot,
    .badge-position--bottom-left.f-badge--coming {
      bottom: 3rem;
      left: 0;
    }

    .badge-position--bottom-left.f-badge--sale,
    .badge-position--bottom-left.f-badge--soldout {
      bottom: 1.5rem;
      left: 0;
    }

    .product-card__badge:not(:has(.f-badge--new, .f-badge--hot, .f-badge--coming)) .badge-position--bottom-left.f-badge--sale,
    .product-card__badge:not(:has(.f-badge--new, .f-badge--hot, .f-badge--coming)) .badge-position--bottom-left.f-badge--soldout {
      bottom: 3rem;
    }
  @media(max-width: 768px ){
    .f-badge{
      font-size:calc(var(--font-body-size) * .7);
    }
  }
</style>