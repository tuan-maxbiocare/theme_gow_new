<style>
  .mega-menu__inner-custom_health {
    display: grid;
    justify-content: space-between;
    grid-template-columns: {{ block.settings.percent-menu-left }}% calc(100% - {{ block.settings.percent-menu-left }}%);
  }

  .mega-menu__col-list {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .mega-menu__section {
    padding-bottom: 20px;
    width: 90%;
  }

  /* .mega-menu__section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  } */

  .mega-menu__title {
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .mega-menu__tags {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .mega-menu__tag {
    display: inline-block;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 500;
    color: #2a3d45;
    background-color: #f5f7fa;
    border: 1px solid #e0e6eb;
    border-radius: 999px;
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    transition: all 0.3s ease;
  }

  .mega-menu__tag:hover {
    background-color: black;
    color: white;
    border-color: black;
    box-shadow: 0 4px 12px rgba(0, 122, 255, 0.2);
  }


  .mega-menu__columns {
    display: flex;
    gap: 80px;
  }

  .mega-menu__col {
    list-style: none;
    flex: 1;
  }

  .mega-menu__col li+li {
    margin-top: 18px;
  }

  .mega-menu__col a {
    position: relative;
    font-size: 15px;
    text-decoration: none;
    transition: color 0.3s;
    display: inline-block;
  }

  .mega-menu__col a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background-color: black;
    transition: width 0.3s ease;
  }

  .mega-menu__col a:hover::after {
    width: 100%;
  }

  .mega-menu__col a:hover {
    color: black;
  }

  .mega-menu__col-banner {
    height: 100%;
    align-items: center;
    justify-content: center;
  }
  .height_banner_health {
    {% if block.settings.height-banner-menu %}
      height: {{ block.settings.height-banner-menu }}px;
    {% endif %}
  }

  .promo-banner-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
    border-radius: 16px;
    overflow: hidden;
  }

  .promo-banner-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
  }
  .mega-menu__inner-custom_health .btn {
    overflow: visible;
  }
</style>

<div class="mega-menu__inner-custom_health">
  <div class="mega-menu__col-list mega-menu-custom-left">
    <div>
      <div class="mega-menu__section">
        <h3 class="mega-menu__title">{{ block.settings['heading-title'] }}</h3>
        <div class="mega-menu__tags">
          <button type="button" class="btn--primary btn btn--secondary btn--small product-card__btn">
            <a href="{{ block.settings.static_link_1_url }}" class="btn__text">
              <span class="btn__text">{{ block.settings.static_link_1_text }}</span>
            </a>
          </button>

          <button type="button" class="btn--primary btn btn--secondary btn--small product-card__btn">
            <a href="{{ block.settings.static_link_2_url }}" class="btn__text">
              <span class="btn__text">{{ block.settings.static_link_2_text }}</span>
            </a>
          </button>

          <button type="button" class="btn--primary btn btn--secondary btn--small product-card__btn">
            <a href="{{ block.settings.static_link_3_url }}" class="btn__text">
              <span class="btn__text">{{ block.settings.static_link_3_text }}</span>
            </a>
          </button>

          <button type="button" class="btn--primary btn btn--secondary btn--small product-card__btn">
            <a href="{{ block.settings.static_link_4_url }}" class="btn__text">
              <span class="btn__text">{{ block.settings.static_link_4_text }}</span>
            </a>
          </button>
        </div>
      </div>

      <div class="mega-menu__section">
        <h3 class="mega-menu__title">{{ block.settings['heading-title-sub'] }}</h3>
        <div class="mega-menu__columns">
          <ul class="mega-menu__col" style="column-count: 2;">
            {% for item in block.settings.child_categories.links %}
              <li>
                <a href="{{ item.link }}">{{ item.title }}</a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="mega-menu__col-banner height_banner_health">
    {% render 'banner-menu-custom', block: block %}
  </div>
</div>
