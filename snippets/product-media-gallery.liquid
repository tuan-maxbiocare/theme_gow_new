{% comment %}
  Renders a product media gallery. Should be used with 'media-gallery.js'

  Accepts:
  - product: {Object} Product liquid object
  - variant_images: {Array} Product images associated with a variant

  Usage:
  {% render 'product-media-gallery' %}
{% endcomment %}

{%- liquid
  assign media_count = product.media.size

  assign has_only_once_media = false
  if media_count < 2
    assign has_only_once_media = true
  endif

  assign media_item_gap = 8
  assign media_item_gap_mobile = 12

  if section.settings.media_size == 'large'
    assign media_width = 0.585
  elsif section.settings.media_size == 'medium'
    assign media_width = 0.5
  elsif section.settings.media_size == 'small'
    assign media_width = 0.45
  endif

  assign enable_mobile_thumbnails = false
  if mobile_thumbnails == 'show'
    assign enable_mobile_thumbnails = true
  endif

  assign enable_desktop_slider = false
  assign slider_css_class = ''
  if has_only_once_media == false
    if media_layout contains 'carousel'
      assign enable_desktop_slider = true
    endif

    assign slider_css_class = slider_css_class | append: ' swiper-show-nav-on-hover'
  endif
-%}
<media-gallery
  id="MediaGallery-{{ section.id }}"
  role="region"
  class="product__media-gallery block relative"
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
  data-media-layout="{{ media_layout }}"
  data-only-image="{{ has_only_once_media }}"
  data-enable-image-zoom="{{ enable_image_zoom }}"
  data-enable-desktop-slider="{{ enable_desktop_slider }}"
  data-enable-mobile-thumbnails="{{ enable_mobile_thumbnails }}"
  data-media-item-gap="{{ media_item_gap }}"
  data-media-item-gap-mobile="{{ media_item_gap_mobile }}"
  data-context="{{ context | default: 'product' }}"
  style="--media-item-gap: {{ media_item_gap }}px; --media-item-gap-mobile: {{ media_item_gap_mobile }}px"
>
  <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
  {%- liquid
    assign current_variant = product.selected_or_first_available_variant
    assign compare_at_price = current_variant.compare_at_price
    assign variant_price = current_variant.price
    assign show_discount_tag = false
    assign discount_percent = 0
    if compare_at_price > variant_price
      assign show_discount_tag = true
      assign discount_percent = compare_at_price | minus: variant_price | times: 100 | divided_by: compare_at_price | round
    endif
  -%}
  <div class="product__media-gallery-viewer-wrap bg-white relative{{ slider_css_class }} {% if section.settings.show_image_border %}blocks-radius{% endif %}">
    <div
      class="product-gallery-discount-tag md:hidden"
      data-discount-tag
      data-product-id="{{ product.id }}"
      {% unless show_discount_tag %}style="display: none;"{% endunless %}
    >
      <span class="discount-tag__text" data-discount-text>Save -{{ discount_percent }}%</span>
    </div>
    <div
      id="GalleryViewer-{{ section.id }}"
      class="product__media-gallery-viewer blocks-radius swiper"
    >
      <a class="skip-to-content-link button visually-hidden" href="#ProductInfo-{{ section.id }}">
        {{ 'accessibility.skip_to_product_info' | t }}
      </a>
      <div
        id="Slider-Gallery-{{ section.id }}"
        class="product__media-list flex swiper-wrapper"
      >
        {%- for media in product.media -%}
          {% render 'product-thumbnail',
            media: media,
            media_count: media_count,
            position: forloop.index0,
            desktop_layout: media_layout,
            mobile_layout: mobile_thumbnails,
            enable_image_zoom: enable_image_zoom,
            loop: section.settings.enable_video_looping,
            modal_id: section.id,
            xr_button: true,
            media_width: media_width
          %}
        {%- endfor -%}
      </div>
    </div>
    {%- if media_count > 1 -%}
      <div class="swiper-controls swiper-controls--nav-floating swiper-controls--grouped-mobile swiper-controls--pagination-fraction justify-center{% if mobile_thumbnails == 'show' %} hidden{% endif %}{% if enable_desktop_slider == false %} md:hidden{% else %} md:flex{% endif %}">
        <button
          type="button"
          class="btn swiper-button swiper-button--drop-shadow swiper-button--blank-mobile swiper-button-prev"
          name="previous"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
        >
          <span class="btn__text">{%- render 'icon-slider-prev' -%}</span>
        </button>
        {%- unless enable_mobile_thumbnails -%}
          <div class="swiper-pagination flex md:hidden"></div>
        {%- endunless -%}
        <button
          type="button"
          class="btn swiper-button swiper-button--drop-shadow swiper-button--blank-mobile swiper-button-next"
          name="next"
          aria-label="{{ 'general.slider.next_slide' | t }}"
        >
          <span class="btn__text">{%- render 'icon-slider-next' -%}</span>
        </button>
      </div>
    {%- endif -%}
    {%- if enable_image_zoom -%}
      <div class="product__media-icon-outer btn btn--white btn--small btn--icon btn--icon-circle" aria-hidden="true">
        <span class="btn__text flex items-center">{%- render 'icon-zoom' -%}</span>
      </div>
    {%- endif -%}
    {% render 'product-awards', product: product, context: 'detail', badge_size: 90 %}
  </div>
  {%- if media_count > 1 and media_layout contains 'carousel' or mobile_thumbnails == 'show' -%}
    {%- liquid
      assign thumbnail_class = ''
      if enable_desktop_slider and mobile_thumbnails != 'show'
        assign thumbnail_class = ' hidden md:block'
      elsif enable_desktop_slider == false and mobile_thumbnails == 'show'
        assign thumbnail_class = ' block md:hidden'
      endif
    -%}
    {%- capture thumbnail_sizes -%}(max-width: 460px) calc((100vw - 30px) / 4), (max-width: 767px) calc((100vw - 30px) / 5), {%- if media_layout == 'vertical-carousel' -%}(max-width: 1023px) 70px, 84px{%- else -%}(max-width: 1023px) calc(min( {{ settings.page_width }}px, 100vw ) * {{ media_width }} / 5), calc(min( {{ settings.page_width }}px, 100vw ) * {{ media_width }} / 7){% endif %}{%- endcapture -%}
    <div
      id="GalleryThumbnails-{{ section.id }}"
      class="product__media-gallery-thumbails swiper{{ thumbnail_class }}"
    >
      <div
        id="Slider-Thumbnails-{{ section.id }}"
        class="thumbnail-list swiper-wrapper"
      >
        {%- for media in product.media -%}
          {%- liquid
            capture media_index
              if media.media_type == 'model'
                increment model_index
              elsif media.media_type == 'video' or media.media_type == 'external_video'
                increment video_index
              elsif media.media_type == 'image'
                increment image_index
              endif
            endcapture
            assign media_index = media_index | plus: 1
          -%}
          <div
            class="product__thumbs-item swiper-slide"
            data-target="{{ media.id }}"
            data-media-position="{{ media_index }}"
          >
            <div class="product__thumbs-container relative blocks-radius-md media-wrapper cursor-pointer">
              <div class="product__thumbs-inner" style="--aspect-ratio: 1">
                {{
                  media.preview_image
                  | image_url: width: media.preview_image.width
                  | image_tag:
                    loading: 'lazy',
                    widths: '70, 84, 100, 140, 168, 200, 300, 400',
                    sizes: thumbnail_sizes,
                    id: thumbnail_id,
                    is: 'image-lazy',
                    alt: media.alt
                  | escape
                }}
              </div>
              {%- if media.media_type == 'model' -%}
                <span class="product__thumbs-badge" aria-hidden="true">
                  {%- render 'icon-3d-model', size: 'extra-small', thickness: 'regular', stroke_scalable: true -%}
                </span>
              {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                <span class="product__thumbs-badge" aria-hidden="true">
                  {%- render 'icon-video', size: 'extra-small', thickness: 'regular', stroke_scalable: true -%}
                </span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</media-gallery>
{% comment %} lương thêm js và css cho chức năng hover  {% endcomment %}
{% comment %} <script>
if (!customElements.get('media-gallery')) {
  customElements.define('media-gallery', class MediaGallery extends HTMLElement {
    constructor() {
      super();
      this.init();
    }
 
    init() {
      // Get elements
      this.thumbnails = this.querySelectorAll('.product__thumbs-item');
      this.mainImages = this.querySelectorAll('.product__media-item');
      this.prevButton = this.querySelector('.swiper-button-prev');
      this.nextButton = this.querySelector('.swiper-button-next');
 
      // Current slide index
      this.currentIndex = 0;
 
      // Add hover event listeners
      this.thumbnails.forEach(thumbnail => {
        thumbnail.addEventListener('mouseenter', this.handleThumbnailHover.bind(this));
      });
 
      // Add navigation listeners
      if (this.prevButton && this.nextButton) {
        this.prevButton.addEventListener('click', () => this.navigate('prev'));
        this.nextButton.addEventListener('click', () => this.navigate('next'));
      }
 
      // Set first image as active by default
      this.setActiveSlide(0);
    }
 
    handleThumbnailHover(event) {
      const thumbnail = event.currentTarget;
      const index = Array.from(this.thumbnails).indexOf(thumbnail);
      this.setActiveSlide(index);
    }
 
    navigate(direction) {
      const totalSlides = this.mainImages.length;
      if (direction === 'prev') {
        this.currentIndex = (this.currentIndex - 1 + totalSlides) % totalSlides;
      } else {
        this.currentIndex = (this.currentIndex + 1) % totalSlides;
      }
      this.setActiveSlide(this.currentIndex);
    }
 
    setActiveSlide(index) {
      this.currentIndex = index;
 
      // Remove active class from all elements
      this.thumbnails.forEach(thumb => thumb.classList.remove('active'));
      this.mainImages.forEach(image => image.classList.remove('active'));
 
      // Add active class to current elements
      this.thumbnails[index]?.classList.add('active');
      this.mainImages[index]?.classList.add('active');
 
      // Update swiper slide position if needed
      const swiperWrapper = this.querySelector('.swiper-wrapper');
      if (swiperWrapper) {
        const slideWidth = this.mainImages[0]?.offsetWidth || 0;
        swiperWrapper.style.transform = `translateX(-${slideWidth * index}px)`;
      }
    }
  });
}
</script>
 
<style>
.product__media-item {
  display: none;
  opacity: 0;
}
 
.product__media-item.active {
  display: block;
  opacity: 1;
}
{% comment %}  
.product__thumbs-item {
  cursor: pointer;
  border: 2px solid transparent;
  transition: border-color 0.2s ease;
}
 
.product__thumbs-item.active,
.product__thumbs-item:hover {
  border-color: var(--color-primary, #000);
}
 
.swiper-button-prev,
.swiper-button-next {
  opacity: 1 !important;
  visibility: visible !important;
}
 
.swiper-wrapper {
  transition: transform 0.3s ease-in-out;
} {% endcomment %}
</style> {% endcomment %}

<style>
  /* Product Gallery Discount Tag - Mobile Only */
  .product-gallery-discount-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 10;
    background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
    color: #ffffff;
    font-size: 12px;
    font-weight: 800;
    padding: 6px 12px;
    border-radius: 4px;
    box-shadow: 0 3px 12px rgba(255, 75, 43, 0.5), 0 0 0 2px rgba(255,255,255,0.9);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    animation: discountTagShine 2s ease-in-out infinite;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .product-gallery-discount-tag.is-hidden {
    opacity: 0;
    transform: scale(0.8);
    pointer-events: none;
  }

  .product-gallery-discount-tag::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    {% comment %} animation: discountTagSweep 2s ease-in-out infinite; {% endcomment %}
    border-radius: 4px;
  }

  @keyframes discountTagShine {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 3px 12px rgba(255, 75, 43, 0.5), 0 0 0 2px rgba(255,255,255,0.9);
    }
    50% {
      transform: scale(1.05);
      box-shadow: 0 4px 20px rgba(255, 75, 43, 0.7), 0 0 0 2px rgba(255,255,255,1), 0 0 15px rgba(255, 75, 43, 0.4);
    }
  }

  @keyframes discountTagSweep {
    0% { left: -100%; }
    50%, 100% { left: 100%; }
  }
</style>

<script>
  // Wait for DOM and FoxTheme to be ready
  function initGalleryDiscountTag() {
    function updateDiscountTag(variant) {
      const discountTag = document.querySelector('[data-discount-tag]');
      if (!discountTag) return;

      const discountText = discountTag.querySelector('[data-discount-text]');
      if (!discountText) return;

      if (variant && variant.compare_at_price && variant.compare_at_price > variant.price) {
        const discountPercent = Math.round((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price);
        discountText.textContent = 'Save -' + discountPercent + '%';
        discountTag.style.display = '';
      } else {
        discountTag.style.display = 'none';
      }
    }

    if (typeof FoxTheme !== 'undefined' && FoxTheme.pubsub && FoxTheme.pubsub.PUB_SUB_EVENTS) {
      FoxTheme.pubsub.subscribe(FoxTheme.pubsub.PUB_SUB_EVENTS.variantChange, function(event) {
        if (event && event.data && event.data.variant) {
          updateDiscountTag(event.data.variant);
        }
      });
    }

    document.addEventListener('variant:changed', function(event) {
      console.log('variant:changed event received', event);
      if (event.detail && event.detail.variant) {
        updateDiscountTag(event.detail.variant);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGalleryDiscountTag);
  } else {
    setTimeout(initGalleryDiscountTag, 100);
  }
</script>
<script>
(function() {
  var GALLERY_ID = 'GalleryViewer-{{ section.id }}';

  function initAwardsVisibility() {
    var galleryEl = document.getElementById(GALLERY_ID);
    if (!galleryEl || !galleryEl.swiper) return false;

    var viewerWrap = galleryEl.closest('.product__media-gallery-viewer-wrap');
    if (!viewerWrap) return true;

    var awards = viewerWrap.querySelector('.product-awards--detail');
    var zoomIcon = viewerWrap.querySelector('.product__media-icon-outer');
    if (!awards && !zoomIcon) return true;

    function updateVisibility() {
      var isFirst = galleryEl.swiper.realIndex === 0;
      if (awards) awards.classList.toggle('product-awards--slide-hidden', !isFirst);
      if (zoomIcon) zoomIcon.classList.toggle('product-awards--slide-hidden', !isFirst);
    }

    galleryEl.swiper.on('slideChange', updateVisibility);
    return true;
  }

  var attempts = 0;
  var interval = setInterval(function() {
    attempts++;
    if (initAwardsVisibility() || attempts > 40) clearInterval(interval);
  }, 100);
})();
</script>