<style>
  .pet-custom__inner {
    max-width: 2000px !important;
    display: flex;
    align-items: flex-start;
  }

  .pet-custom__col-list {
    width: 50%;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .pet-custom__section {
    padding-bottom: 20px;
    border-bottom: 1px solid #e0e6eb;
  }

  .pet-custom__section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .pet-custom__title {
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 16px;
    color: #2a3d45;
  }

  .pet-custom__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pet-custom__list li {
    margin-bottom: 12px;
  }

  .pet-custom__link {
    font-size: 15px;
    text-decoration: none;
    color: #4a5a64;
    transition: color 0.3s;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 0;
  }

  .pet-custom__link:hover {
    color: #007aff;
  }

  .pet-custom__icon {
    width: 80px;
    object-fit: contain;
  }

  .pet-custom__col-images {
    width: 70%;
    position: relative;
    height: 400px;
    overflow: hidden;
    border-radius: 8px;
  }

  .pet-custom__intro-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .pet-custom__bg-overlay {
    display: block !important;
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 100%;
    backdrop-filter: blur(8px);
    z-index: 1;
    border-radius: 0 8px 8px 0;
    pointer-events: none;
  }

  .pet-custom__product-section {
    position: absolute;
    top: 0;
    right: 0;
    width: 40%;
    height: 100%;
    z-index: 2;
    border-radius: 0 8px 8px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
    background: transparent;
  }

  .pet-custom__product-img {
    width: 80px;
    height: auto;
    object-fit: contain;
    margin-bottom: 20px;
  }

  .pet-custom__product-text {
    color: black;
    font-size: 20px;
    font-weight: 700;
    text-align: center;
    line-height: 1.3;
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .pet-custom__buy-button {
    background: white;
    color: #2a3d45;
    border: 1px solid #dee2e6;
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
  }

  .pet-custom__buy-button:hover {
    background: #f8f9fa;
    transform: translateY(-1px);
  }

  .pet-custom__arrow {
    width: 12px;
    height: 12px;
  }

  @media (max-width: 1024px) {
    .pet-custom__inner {
      flex-direction: column;
      gap: 40px;
    }

    .pet-custom__col-list,
    .pet-custom__col-images {
      width: 100%;
    }

    .pet-custom__col-images {
      height: 300px;
    }
  }

  @media (max-width: 767px) {
    .pet-custom__col-images {
      height: 250px;
    }

    .pet-custom__product-section {
      width: 100%;
      height: auto;
      top: auto;
      bottom: 0;
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      gap: 16px;
      padding: 16px;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(3px);
      border-radius: 0 0 8px 8px;
    }

    .pet-custom__product-img {
      width: 60px;
      height: 90px;
      margin: 0;
    }

    .pet-custom__product-text {
      font-size: 12px;
      margin: 0;
      flex: 1;
      color: #ffffff;
    }

    .pet-custom__buy-button {
      padding: 8px 12px;
      font-size: 11px;
    }
  }

  .underline-effect {
    color: black;
    position: relative;
    display: inline-block;
    transition: color 0.3s ease;
  }

  .underline-effect::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0%;
    height: 2px;
    background-color: black;
    transition: width 0.3s ease;
  }

  .pet-custom__link:hover .underline-effect::after {
    width: 100%;
  }
</style>

<div class="pet-custom__inner">
  <div class="pet-custom__col-list mega-menu-custom-left">
    <div class="pet-custom__section">
      <ul class="pet-custom__list">
        <li class="hover-wrapper">
          <a href="{{ block.settings.collection_1 }}" class="pet-custom__link">
            <img src="{{ block.settings.collection_image_1 | image_url }}" alt="Cat Icon" class="pet-custom__icon hover-scale-up">
            <span class="underline-effect">{{ block.settings.collection_title_1 }}</span>
          </a>
        </li>
        <li class="hover-wrapper">
          <a href="{{ block.settings.collection_2 }}" class="pet-custom__link">
            <img src="{{ block.settings.collection_image_2 | image_url }}" alt="Cat Icon" class="pet-custom__icon hover-scale-up">
            <span class="underline-effect">{{ block.settings.collection_title_2 }}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Column 2: Image Section -->
  <div class="mega-menu__col-banner">
    {% render 'banner-menu-custom' , image_1 : block.settings.banner_image_1%}
  </div>
</div>