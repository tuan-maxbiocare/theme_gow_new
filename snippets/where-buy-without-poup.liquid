<style>
a.link-buy-btn.first img {
	max-width: 75px;
}
.where-but-btn {
	display: flex;
	flex-wrap:wrap;
}
  .buybtn-flex {
	width: 100%;
   
}
  .heading-buy {
	width: 100%;
     MARGIN-BOTTOM: 15PX;
}
 .buybtn-flex {
	width: 100%;
	display: flex;
	column-gap:15px;
	max-width: 325px;
   align-items: center;
}
.buybtn-flex a.link-buy-btn.first:first-child img {
	max-width: 50px;
}
.buybtn-flex a.link-buy-btn.first {
	border: 1px solid #1d1d1d;
	border-radius: 50px;
	padding: 10px 10px;
	height: 85%;
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
}
a.shopee.link-buy-btn.first img {
	max-width: 80px !important;
}
a.lazada.link-buy-btn.first img {
	max-width: 85px !important;
}
</style>
{% comment %} {% if product.metafields.custom.shopee_link or product.metafields.custom.lazada_link or product.metafields.custom.garden_of_wellness_link %}
<div class="where-but-btn">
  <div class="heading-buy"><h4>ALSO AVAILABLE ON:</h4></div>
  <div class="buybtn-flex">
     {% if product.metafields.custom.garden_of_wellness_link %}
  <a href="{{ product.metafields.custom.garden_of_wellness_link }}" class="garden-well link-buy-btn first">
        <img src="https://cdn.shopify.com/s/files/1/0677/1900/4417/files/Amazon_PNG6.png?v=1746766344" alt="Samsung Shop">
  </a>
  {% endif %}
{% if product.metafields.custom.shopee_link %}
  <a href="{{ product.metafields.custom.shopee_link }}" class="shopee link-buy-btn first">
    <img src="https://cdn.shopify.com/s/files/1/0729/2105/5460/files/Shopee_Laz-02.webp?v=1754020370" alt="Shopee Shop">
  </a>
  {% endif %}
  {% if product.metafields.custom.lazada_link %}
  <a href="{{ product.metafields.custom.lazada_link }}" class="lazada link-buy-btn first">
        <img src="https://cdn.shopify.com/s/files/1/0729/2105/5460/files/Shopee_Laz-01.webp?v=1754020370" alt="Samsung Shop">
  </a>
  {% endif %}
  
  </div>
</div>
{% endif %} {% endcomment %}