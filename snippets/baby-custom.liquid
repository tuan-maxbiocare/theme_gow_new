<style>
  .baby-custom-mega-menu__inner {
    max-width: 2000px !important;
    display: flex;
    gap: 80px;
  }

  .baby-custom-mega-menu__col-list {
    width: 55%;
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  .baby-custom-mega-menu__section {
    padding-bottom: 20px;
    border-bottom: 1px solid #e0e6eb;
  }

  .baby-custom-mega-menu__section:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .baby-custom-mega-menu__title {
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .baby-custom-mega-menu__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    width: 100%;
    justify-content: space-between;
  }

  .baby-custom-mega-menu__tag {
    padding: 14px 28px;
    font-size: 15px;
    text-decoration: none;
    transition: color 0.3s;
    flex: 1;
    text-align: center;
    min-width: 0;
  }

  .baby-custom-mega-menu__tag:hover {
    color: #007aff;
  }

  .baby-custom-mega-menu__columns {
    display: flex;
    gap: 80px;
  }

  .baby-custom-mega-menu__col {
    list-style: none;
    flex: 1;
  }

  .baby-custom-mega-menu__col li+li {
    margin-top: 18px;
  }

  .baby-custom-mega-menu__col a {
    font-size: 15px;
    text-decoration: none;
    transition: color 0.3s;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .baby-custom-mega-menu__col-icon {
    object-fit: contain;
    flex-shrink: 0;
    width: 80px;
  }

  .baby-custom-mega-menu__col-banner {
    width: 55%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .baby-custom-mega-menu__banner-img {
    height: auto;
    object-fit: contain;
    display: block;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .baby-custom-mega-menu__inner {
      flex-direction: column;
      gap: 40px;
      align-items: center;
    }

    .baby-custom-mega-menu__col-list,
    .baby-custom-mega-menu__col-banner {
      width: 100%;
    }

    .baby-custom-mega-menu__columns {
      flex-direction: column;
      gap: 40px;
    }
  }

  @media (max-width: 767px) {
    .baby-custom-mega-menu {
      padding: 40px 20px;
    }

    .baby-custom-mega-menu__tag {
      padding: 10px 20px;
      font-size: 14px;
    }
  }

  .baby-custom-mega-menu__col-icon {
    position: relative;
    display: inline-block;
    overflow: hidden;
  }

  .baby-custom-mega-menu__col-icon::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0%;
    height: 2px;
    background-color: #007aff;
    transition: width 0.3s ease;
  }

  .baby-custom-mega-menu__col-icon::after {
    width: 100%;
  }

  .baby-custom-mega-menu__col a .link-text {
    position: relative;
    display: inline-block;
    overflow: hidden;
  }

  .baby-custom-mega-menu__col a .link-text::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0%;
    height: 2px;
    background-color: black;
    transition: width 0.3s ease;
  }

  .baby-custom-mega-menu__col a:hover .link-text::after {
    width: 100%;
  }

  .promo-product-img {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    transform-origin: center center;
    transition: transform 0.6s ease-out;
  }

  .promo-product-img:hover {
    transform: translateY(-50%) scale(1.05);
  }
</style>

<div class="baby-custom-mega-menu__inner">
  <div class="baby-custom-mega-menu__col-list">
    <div class="baby-custom-mega-menu__section">
      <h3 class="baby-custom-mega-menu__title">{{ block.settings.heading-title }}</h3>
      <div class="baby-custom-mega-menu__tags">
        <motion-element class="block" data-motion="fade-up" data-motion-delay="150">
          <a href="{{ block.settings.static_link_1_url }}" class="btn btn--primary user-group-btn">
            <span class="btn__text">{{ block.settings.static_link_1_text }}</span>
          </a>
        </motion-element>
        <motion-element class="block" data-motion="fade-up" data-motion-delay="150">
          <a href="{{ block.settings.static_link_2_url }}" class="btn btn--primary user-group-btn">
            <span class="btn__text">{{ block.settings.static_link_2_text }}</span>
          </a>
        </motion-element>
        <motion-element class="block" data-motion="fade-up" data-motion-delay="150">
          <a href="{{ block.settings.static_link_3_url }}" class="btn btn--primary user-group-btn">
            <span class="btn__text">{{ block.settings.static_link_3_text }}</span>
          </a>
        </motion-element>
      </div>
    </div>

    <div class="baby-custom-mega-menu__section">
      <h3 class="baby-custom-mega-menu__title">{{ block.settings.heading-title-sub }}</h3>
      <div class="baby-custom-mega-menu__columns">
        <ul class="baby-custom-mega-menu__col">
          <li class="hover-wrapper">
            <a href="{{ block.settings.collection_1 }}">
              <img src="{{ block.settings.collection_image_1 }}">
              <span class="link-text">{{ block.settings.collection_title_1 }}</span>
            </a>
          </li>
          <li class="hover-wrapper">
            <a href="{{ block.settings.collection_2 }}">
              <img src="{{ block.settings.collection_image_2 }}">
              <span class="link-text">{{ block.settings.collection_title_2 }}</span>
            </a>
          </li>
          <li class="hover-wrapper">
            <a href="{{ block.settings.collection_3 }}">
              <img src="{{ block.settings.collection_image_3 }}">
              <span class="link-text">{{ block.settings.collection_title_3 }}</span>
            </a>
          </li>
          <li class="hover-wrapper">
            <a href="{{ block.settings.collection_4 }}">
              <img src="{{ block.settings.collection_image_4 }}">
              <span class="link-text">{{ block.settings.collection_title_4 }}</span>
            </a>
          </li>
          <li class="hover-wrapper">
            <a href="{{ block.settings.collection_5 }}">
              <img src="{{ block.settings.collection_image_5 }}">
              <span class="link-text">{{ block.settings.collection_title_5 }}</span>
            </a>
          </li>
          <li class="hover-wrapper">
            <a href="{{ block.settings.collection_6 }}">
              <img src="{{ block.settings.collection_image_6 }}">
              <span class="link-text">{{ block.settings.collection_title_6 }}</span>
            </a>
          </li>

        </ul>
      </div>
    </div>
  </div>

  <div class="mega-menu__col-banner">
    {% render 'banner-menu-custom' , image_1 : block.settings.banner_image_1, image_2 : block.settings.banner_image_2%}
  </div>
</div>