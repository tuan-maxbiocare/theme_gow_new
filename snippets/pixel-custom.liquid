<!-- Google tag (gtag.js) high-performance optimization -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  (function() {
    var gtmLoaded = false;
    function loadGTM(e) {
      if (gtmLoaded) return;
      gtmLoaded = true;
      
      // Cleanup event listeners
      ['scroll', 'mousemove', 'touchstart'].forEach(function(evt) {
        window.removeEventListener(evt, loadGTM);
      });

      var script = document.createElement('script');
      script.src = "https://www.googletagmanager.com/gtag/js?id=GT-TQKZ8HLF";
      script.async = true;
      document.head.appendChild(script);
      gtag('config', 'GT-TQKZ8HLF');
    }

    // Load on interaction
    ['scroll', 'mousemove', 'touchstart'].forEach(function(evt) {
      window.addEventListener(evt, loadGTM, { once: true, passive: true });
    });

    // Lazy fallback
    if ('requestIdleCallback' in window) {
      window.requestIdleCallback(function() { setTimeout(loadGTM, 3000); });
    } else {
      setTimeout(loadGTM, 4000);
    }
  })();
</script>