<!-- Defer Clarity Analytics - Load after 4 seconds or on scroll -->
<script>
  (function() {
    var clarityLoaded = false;
    function loadClarity() {
      if (clarityLoaded) return;
      clarityLoaded = true;
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "tnwn5025c9");
    }

    window.addEventListener('load', function() {
      setTimeout(loadClarity, 4000);
    });

    // Also load on first scroll
    window.addEventListener('scroll', loadClarity, { once: true, passive: true });
  })();
</script>
    



    
