{%- liquid
  # Define tiers
  assign tier1_threshold = tier1_threshold | default: 50000
  assign tier1_collection = tier1_collection | default: 'gift-500'

  assign tier2_threshold = tier2_threshold | default: 100000
  assign tier2_collection = tier2_collection | default: 'gift-1000'

  # assign tier3_threshold = tier3_threshold | default: 150000
  # assign tier3_collection = tier3_collection | default: 'gift-1500'

  assign tiers = ''
  assign tiers = tiers | append: tier1_threshold | append: ',' | append: tier1_collection | append: '|'
  assign tiers = tiers | append: tier2_threshold | append: ',' | append: tier2_collection | append: '|'
  # assign tiers = tiers | append: tier3_threshold | append: ',' | append: tier3_collection

  # Calculate cart total
  assign cart_total_for_gift = 0
  assign gift_items_in_cart = ''
  assign all_gift_tiers = ''

  for item in cart.items
    assign is_gift_item = false
    if item.properties._free_gift == 'true'
      assign is_gift_item = true
      assign item_tier = item.properties._gift_tier | plus: 0

      if gift_items_in_cart == ''
        assign gift_items_in_cart = item_tier | append: ':' | append: item.key
      else
        assign gift_items_in_cart = gift_items_in_cart | append: ',' | append: item_tier | append: ':' | append: item.key
      endif

      if all_gift_tiers == ''
        assign all_gift_tiers = item_tier | append: ''
      else
        assign all_gift_tiers = all_gift_tiers | append: ',' | append: item_tier
      endif
    endif

    unless is_gift_item
      assign cart_total_for_gift = cart_total_for_gift | plus: item.final_line_price
    endunless
  endfor

  # Determine current tier
  assign current_tier = 0
  # if cart_total_for_gift >= tier3_threshold
  # assign current_tier = 3
  if cart_total_for_gift >= tier2_threshold
    assign current_tier = 2
  elsif cart_total_for_gift >= tier1_threshold
    assign current_tier = 1
  endif

  # Check lower tier gifts
  assign has_lower_tier_gifts = false
  assign lower_tier_gift_keys = ''

  if current_tier > 0
    for item in cart.items
      if item.properties._free_gift == 'true'
        assign item_tier = item.properties._gift_tier | plus: 0
        if item_tier < current_tier
          assign has_lower_tier_gifts = true
          if lower_tier_gift_keys == ''
            assign lower_tier_gift_keys = item.key
          else
            assign lower_tier_gift_keys = lower_tier_gift_keys | append: ',' | append: item.key
          endif
        endif
      endif
    endfor
  endif

  # Calculate progress
  assign progress_percent = 0
  if current_tier == 0
    assign progress_percent = cart_total_for_gift | times: 100 | divided_by: tier1_threshold
  elsif current_tier == 1
    assign range = tier2_threshold | minus: tier1_threshold
    assign current_progress = cart_total_for_gift | minus: tier1_threshold
    assign tier_progress = current_progress | times: 100 | divided_by: range
    assign progress_percent = 33 | plus: tier_progress | times: 0.33
    # elsif current_tier == 2
    # assign range = tier3_threshold | minus: tier2_threshold
    # assign current_progress = cart_total_for_gift | minus: tier2_threshold
    # assign tier_progress = current_progress | times: 100 | divided_by: range
    # assign progress_percent = 66 | plus: tier_progress | times: 0.34
  else
    assign progress_percent = 100
  endif
-%}

{%- assign free_gift_section_id = section_id | default: section.id | default: 'cart-drawer' -%}

<free-gift-unlock
  class="free-gift-unlock"
  data-tiers="{{ tiers }}"
  data-section-id="{{ free_gift_section_id }}"
  data-current-tier="{{ current_tier }}"
  data-cart-total="{{ cart_total_for_gift }}"
  data-gift-items="{{ gift_items_in_cart }}"
  data-lower-tier-gifts="{{ lower_tier_gift_keys }}"
  data-has-lower-tier-gifts="{{ has_lower_tier_gifts }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  <div class="free-gift-unlock__container">
    {%- comment -%} Progress Timeline {%- endcomment -%}
    <div class="free-gift-timeline">
      <div class="free-gift-timeline__track">
        <div
          class="free-gift-timeline__progress"
          data-progress-bar
          style="width: {{ progress_percent }}%"
        ></div>
      </div>

      <div class="free-gift-timeline__milestones">
        {%- comment -%} Tier 1 Milestone {%- endcomment -%}
        <div class="milestone{% if current_tier >= 1 %} milestone--unlocked{% endif %}" data-tier="1">
          <div class="milestone__marker">
            {%- if current_tier >= 1 -%}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" fill="currentColor"/>
                <path d="M8 12L11 15L16 9" stroke="white" stroke-width="2" stroke-linecap="round"/>
              </svg>
            {%- else -%}
              <span class="milestone__number">1</span>
            {%- endif -%}
          </div>
          <div class="milestone__label">
            <span class="milestone__amount">{{ tier1_threshold | money }}</span>
            <span class="milestone__text">Free Shipping</span>
          </div>
        </div>

        {%- comment -%} Tier 2 Milestone {%- endcomment -%}
        <div class="milestone{% if current_tier >= 2 %} milestone--unlocked{% endif %}" data-tier="2">
          <div class="milestone__marker">
            {%- if current_tier >= 2 -%}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" fill="currentColor"/>
                <path d="M8 12L11 15L16 9" stroke="white" stroke-width="2" stroke-linecap="round"/>
              </svg>
            {%- else -%}
              <span class="milestone__number">2</span>
            {%- endif -%}
          </div>
          <div class="milestone__label">
            <span class="milestone__amount">{{ tier2_threshold | money }}</span>
            <span class="milestone__text">Free Gift</span>
          </div>
        </div>

        {%- comment -%} Tier 3 Milestone {%- endcomment -%}
        {% comment %}
          <div class="milestone{% if current_tier >= 3 %} milestone--unlocked{% endif %}" data-tier="3">
            <div class="milestone__marker">
              {%- if current_tier >= 3 -%}
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" fill="currentColor"/>
                  <path d="M8 12L11 15L16 9" stroke="white" stroke-width="2" stroke-linecap="round"/>
                </svg>
              {%- else -%}
                <span class="milestone__number">3</span>
              {%- endif -%}
            </div>
            <div class="milestone__label">
              <span class="milestone__amount">{{ tier3_threshold | money }}</span>
              <span class="milestone__text">Tier 3</span>
            </div>
          </div>
        {% endcomment %}
      </div>

      {%- comment -%} Current Status Message {%- endcomment -%}
      {%- comment -%} Current Status Message {%- endcomment -%}
      <div class="free-gift-timeline__status" data-status-message>
        {%- if current_tier == 0 -%}
          {%- liquid
            assign remaining = tier1_threshold | minus: cart_total_for_gift
            assign remaining_money = remaining | money
          -%}
          <p class="text-sm">
            <strong>{{ remaining_money }}</strong> away from Free Shipping! 🚚
          </p>
        {%- elsif current_tier == 1 -%}
          {%- liquid
            assign remaining = tier2_threshold | minus: cart_total_for_gift
            assign remaining_money = remaining | money
          -%}
          <p class="text-sm text-emerald-600">
            🎉 Free Shipping unlocked! Add <strong>{{ remaining_money }}</strong> more for a FREE gift
          </p>
        {%- else -%}
          <p class="text-sm text-emerald-600 font-body-bolder">🎉 Congratulations! You've unlocked all rewards!</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Gift Selector {%- endcomment -%}
    {% comment %} assign current_tier_collection_handle = tier1_collection {% endcomment %}
    {% comment %} if current_tier == 2 {% endcomment %}
    {% comment %}
      if current_tier == 3
        assign current_tier_collection_handle = tier3_collection
      endif
    {% endcomment %}
    {%- if current_tier > 1 -%}
      {%- liquid
        assign current_tier_collection_handle = tier2_collection

        assign tier_collection = collections[current_tier_collection_handle]
        assign current_tier_gift_added = false
        assign current_tier_string = current_tier | append: ''

        if all_gift_tiers contains current_tier_string
          assign current_tier_gift_added = true
        endif
      -%}

      {%- if has_lower_tier_gifts -%}
        <div class="free-gift-upgrading">
          <div class="flex items-center gap-2 text-blue-600">
            <svg class="animate-spin" width="20" height="20" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" opacity="0.25"/>
              <path d="M12 2C6.47715 2 2 6.47715 2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span class="font-body-bolder">Upgrading to Tier {{ current_tier }}...</span>
          </div>
        </div>
      {%- elsif current_tier_gift_added -%}
        <div class="free-gift-selected">
          <div class="flex items-center gap-2 text-emerald-600">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" fill="currentColor"/>
              <path d="M8 12L11 15L16 9" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span class="font-body-bolder">Gift selected!</span>
          </div>
          <button type="button" class="btn btn--plain text-sm" data-change-gift="{{ current_tier }}">
            Change gift
          </button>
        </div>
      {%- else -%}
        <div class="free-gift-selector" data-tier-selector="{{ current_tier }}">
          <div class="snow-container"><div class="snow"></div></div>
          <div class="free-gift-selector__header">
            <h4 class="h6 mb-0">🎁 Select Your FREE Gift</h4>
            <p class="text-sm text-subtext">Choose one item below</p>
          </div>

          {%- if tier_collection != blank and tier_collection.products.size > 0 -%}
            <div class="free-gift-selector__grid">
              {%- for product in tier_collection.products limit: 6 -%}
                {%- liquid
                  assign free_variant = null
                  for variant in product.variants
                    if variant.price == 0
                      assign free_variant = variant
                      break
                    endif
                  endfor
                  if free_variant == null
                    assign free_variant = product.selected_or_first_available_variant
                  endif
                -%}

                <div
                  class="gift-card{% if forloop.first %} gift-card--selected{% endif %}"
                  data-gift-variant="{{ free_variant.id }}"
                  data-gift-tier="{{ current_tier }}"
                  data-product-title="{{ product.title | escape }}"
                >
                  {%- if product.featured_image -%}
                    <div class="gift-card__image">
                      {{
                        product.featured_image
                        | image_url: width: 200
                        | image_tag: loading: 'lazy', widths: '100,200', class: 'w-full h-full object-cover'
                      }}
                    </div>
                  {%- endif -%}

                  <div class="gift-card__info">
                    <p class="gift-card__title h5">{{ product.title }}</p>
                    <p class="gift-card__description">{{ product.metafields.custom.description }}</p>
                    <p class="gift-card__price">
                      <span class="text-emerald-600 font-body-bolder">FREE</span>
                    </p>
                  </div>

                  <div class="gift-card__check">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                      <circle cx="10" cy="10" r="10" fill="currentColor"/>
                      <path d="M6 10L9 13L14 7" stroke="white" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </div>
                </div>
              {%- endfor -%}
            </div>

            <button type="button" class="btn btn--primary w-full mt-4" data-add-gift-btn="{{ current_tier }}">
              <span class="btn__text">Add FREE Gift to Cart</span>
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</free-gift-unlock>
