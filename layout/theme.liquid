{% liquid
  assign enable_rtl = settings.enable_rtl
  assign language_support_rtl = settings.language_support_rtl
  if enable_rtl and language_support_rtl != blank
    assign shop_locale = localization.language.iso_code
    assign language_support_rtl_list = language_support_rtl | split: ','
    assign is_rtl = language_support_rtl_list | where: shop_locale
    if is_rtl.size > 0
      assign enable_rtl = true
    else
      assign enable_rtl = false
    endif 
  endif
%}
<!doctype html>
<html
  class="no-js{% if cart != empty %} cart-has-items{% endif %}"
  lang="{{ request.locale.iso_code }}"
  {% if enable_rtl %}
    dir="rtl"
  {% endif %}
>
  <head>
    
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      <link rel="dns-prefetch" href="https://fonts.shopifycdn.com">
    {%- endunless -%}
{% comment %} code cũ meta tag SEO cũ {% endcomment %}
    {% comment %} <title>
      {{- page_title -}}
      {%- if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- if template == 'password' -%}
        {{- shop.name -}}
      {%- else -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title> {% endcomment %}
    {% comment %} mới {% endcomment %}
    <title>
      {{- page_title -}}
      {%- if current_tags -%}
        {%- assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags -}}
      {%- endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- if template == 'password' -%}
        {{- shop.name -}}
      {%- elsif template == 'article' or template == 'blog' -%}
      {%- else -%}
        {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
      {%- endif -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {%- liquid
      render 'meta-tags'
      render 'css-variables'
    -%}

    {{ 'vendor.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <link rel="stylesheet" href="{{ 'component-card-img-with-product.css' | asset_url }}" media="print" onload="this.media='all';this.onload=null;">
    <link rel="stylesheet" href="{{ 'custom-theme.css' | asset_url }}" media="print" onload="this.media='all';this.onload=null;">

    {%- if settings.enable_product_compare -%}
      <link rel="stylesheet" href="{{ 'compare.css' | asset_url }}" media="print" onload="this.media='all';this.onload=null;">
    {%- endif -%}

    {%- if enable_rtl -%}
      <link rel="stylesheet" href="{{ 'rtl.css' | asset_url }}" media="print" onload="this.media='all';this.onload=null;">
    {%- endif -%}

    <noscript>
      {{ 'component-card-img-with-product.css' | asset_url | stylesheet_tag }}
      {{ 'custom-theme.css' | asset_url | stylesheet_tag }}
      {%- if settings.enable_product_compare -%}
        {{ 'compare.css' | asset_url | stylesheet_tag }}
      {%- endif -%}
      {%- if enable_rtl -%}
        {{ 'rtl.css' | asset_url | stylesheet_tag }}
      {%- endif -%}
    </noscript>

    <style>
      .lazy-section {
        content-visibility: auto;
        contain-intrinsic-size: 1px 800px;
      }

      @font-face {
        font-display: swap;
      }
    </style>

    {%- comment -%}
      PERFORMANCE OPTIMIZATION: Disable content_for_header on homepage
      This removes Shopify Web Pixel Manager (~2-3s TBT) from homepage
      WPM is not needed on homepage (no checkout/cart tracking)
    {%- endcomment -%}
    {%- if template == 'index' -%}
      <!-- content_for_header disabled on homepage for performance -->
      <script>
        var Shopify = Shopify || {};
        Shopify.shop = "{{ shop.permanent_domain }}";
        Shopify.locale = "{{ request.locale.iso_code }}";
        Shopify.currency = {
          active: "{{ cart.currency.iso_code }}",
          rate: "{{ cart.currency.rate_to_default_currency }}"
        };
        Shopify.theme = {
          name: "{{ theme.name }}",
          id: {{ theme.id }},
          role: "main"
        };
        Shopify.routes = {
          root: "{{ routes.root_url }}"
        };
        Shopify.designMode = {{ request.design_mode }};

        // Mock loadFeatures and autoloadFeatures
        Shopify.loadFeatures = function(features, callback) {
          if (typeof callback === 'function') {
            callback(null, Shopify.customerPrivacy);
          }
        };
        Shopify.autoloadFeatures = function(features, callback) {
          if (typeof callback === 'function') {
            callback(null, Shopify.customerPrivacy);
          }
        };

        // Mock customerPrivacy - allow all tracking
        Shopify.customerPrivacy = {
          marketingAllowed: function() { return true; },
          analyticsProcessingAllowed: function() { return true; },
          preferencesProcessingAllowed: function() { return true; },
          saleOfDataAllowed: function() { return true; },
          firstPartyMarketingAllowed: function() { return true; },
          thirdPartyMarketingAllowed: function() { return true; },
          setTrackingConsent: function() {},
          getTrackingConsent: function() { return "accepted"; },
          shouldShowBanner: function() { return false; },
          userCanBeTracked: function() { return true; }
        };
      </script>
    {%- else -%}
      {{ content_for_header }}
    {%- endif -%}

    {%- comment -%} Preload LCP image for homepage to improve performance {%- endcomment -%}
    {%- if template.name == 'index' -%}
      <link rel="preload" as="image" href="https://cdn.shopify.com/s/files/1/0677/1900/4417/files/garden-of-wellness-shop-xmas2025-homepage-banner-desktop-2200x1555.webp" media="(min-width: 768px)" fetchpriority="high">
      <link rel="preload" as="image" href="https://cdn.shopify.com/s/files/1/0677/1900/4417/files/garden-of-wellness-shop-xmas2025-homepage-banner-mobile-1000x1505.webp" media="(max-width: 767px)" fetchpriority="high">
    {%- endif -%}

    {% render 'pixel-custom' %}

    <script src="{{ 'vendor.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script data-src="{{ 'header.js' | asset_url }}" defer="defer" class="lazy-js"></script>
    <script data-src="{{ 'footer.js' | asset_url }}" defer="defer" class="lazy-js"></script>
    {%- if request.page_type contains 'customers/' -%}
    <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
    {%- endif -%}
    
    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>
    
    {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
    
    {%- render 'js-variables' -%}
    
    {% comment %} Custom metafield for head tag like GTag tracking {% endcomment %}
    {{ shop.metafields.foxtheme.code_head.value }}
    {% comment %} End custom metafield for head tag like GTag tracking {% endcomment %}
    
    {% if template == 'index' %}
    <script data-src="{{ 'featured-collection.js' | asset_url }}" defer="defer" class="lazy-js"></script>
    <script data-src="{{ 'scrolling-banner.js' | asset_url }}" defer="defer" class="lazy-js"></script>
    {% endif %}
    
    <script>
      (function() {
        'use strict';

        function loadDataSrcScripts() {
          document.querySelectorAll("script[data-src]").forEach(function(tag) {
            tag.src = tag.getAttribute("data-src");
            tag.removeAttribute("data-src");
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener("DOMContentLoaded", loadDataSrcScripts);
        } else {
          loadDataSrcScripts();
        }
      })();
    </script>

    {%- comment -%}
      PERFORMANCE PRIORITY 2: MutationObserver for section CSS deferral
      Intercepts section CSS as they're added to DOM and defers them
      Expected impact: FCP -500ms, PageSpeed +10-15 points
    {%- endcomment -%}
    <script>
      (function() {
        'use strict';

        var sectionCSSPatterns = [
          'section-',
          'component-grid-banner',
          'component-multicolumn',
          'component-collection-item-slider',
          'component-article-card',
          'component-deferred-media',
          'component-lookbook',
          'component-custom-',
          'collection.css',
          'cart.css'
        ];

        function shouldDeferCSS(href) {
          if (!href) return false;
          return sectionCSSPatterns.some(function(pattern) {
            return href.indexOf(pattern) !== -1;
          });
        }

        function deferCSS(link) {
          if (link.media === 'all' && shouldDeferCSS(link.href)) {
            link.media = 'print';
            link.onload = function() {
              this.media = 'all';
              this.onload = null;
            };
            // Fallback timeout
            setTimeout(function() {
              link.media = 'all';
            }, 3000);
          }
        }

        // Process existing CSS links
        var existingLinks = document.querySelectorAll('link[rel="stylesheet"]');
        existingLinks.forEach(deferCSS);

        // Observe for new CSS links added dynamically
        var observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(mutation) {
            mutation.addedNodes.forEach(function(node) {
              if (node.tagName === 'LINK' && node.rel === 'stylesheet') {
                deferCSS(node);
              }
            });
          });
        });

        observer.observe(document.documentElement, {
          childList: true,
          subtree: true
        });
      })();
    </script>

    {%- if request.page_type contains 'customers/' -%}
      <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
    {%- endif -%}

    <script>
      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>

    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- render 'js-variables' -%}


     <!-- Microsoft Clarity Tracking Code -->
      <script>
        (function() {
          var clarityLoaded = false;
          function loadClarity() {
            if (clarityLoaded) return;
            clarityLoaded = true;
            (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
            })(window, document, "clarity", "script", "tnwn5025c9");
          }

          window.addEventListener('load', function() {
            setTimeout(loadClarity, 5000);
          });

          window.addEventListener('scroll', loadClarity, { once: true, passive: true });
        })();
      </script>
      <!-- End Microsoft Clarity Tracking Code -->


  </head>
  <body
    class="{{ request.page_type }}-template {{ template.suffix }} blocks-corner--{{ settings.blocks_corner_radius }}{% if request.design_mode %} shopify-design-mode{% endif %}"
    data-initializing
  >
    <h1 style="display: none;">{{- page_title -}} </h1>
    {% comment %} Custom metafield for body tag like GTag tracking {% endcomment %}
    {{ shop.metafields.foxtheme.code_body.value }}
    {% comment %} End custom metafield for body tab like GTag tracking {% endcomment %}

    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {%- liquid
      if settings.enable_page_transition
        render 'page-transition'
      endif
    -%}

    <div class="site-wrapper min-height-screen">
      {% sections 'header-group' %}

      <main id="MainContent" class="main-content content-for-layout focus-none" role="main" tabindex="-1">
        {{ content_for_layout }}
      </main>

      {% sections 'footer-group' %}
    </div>

    {% sections 'overlay-group' %}
    {%- liquid
      if settings.enable_back_to_top
        render 'back-to-top'
      endif
    -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    {% if settings.pcard_show_quickview_button or settings.pcard_choose_options_actions == 'open_popup' %}
      <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    {%- if settings.enable_product_compare -%}
      <script src="{{ 'compare.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <!-- Defer Klaviyo for better performance -->
    <script>
      window.addEventListener('load', function() {
        setTimeout(function() {
          var klaviyoScript = document.createElement('script');
          klaviyoScript.async = true;
          klaviyoScript.src = 'https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=TTMw4F';
          document.head.appendChild(klaviyoScript);
        }, 4000);
      });
    </script>
    <!-- End  Klaviyo for better performance -->


  </body>
</html>
