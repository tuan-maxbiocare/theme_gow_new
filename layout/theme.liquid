    {% endif %}

    {%- if settings.enable_product_compare -%}
      <script src="{{ 'compare.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

 <script>
document.addEventListener("DOMContentLoaded", function () {
  var klaviyoLoaded = false;
  function loadKlaviyo() {
    if (klaviyoLoaded) return;
    klaviyoLoaded = true;
    var s = document.createElement("script");
    s.src = "https://static.klaviyo.com/onsite/js/klaviyo.js?company_id=SUMfeq";
    s.async = true;
    document.body.appendChild(s);
  }
  // Load on user interaction or delay
  window.addEventListener('scroll', loadKlaviyo, { once: true, passive: true });
  window.addEventListener('mousemove', loadKlaviyo, { once: true, passive: true });
  window.addEventListener('touchstart', loadKlaviyo, { once: true, passive: true });
  setTimeout(loadKlaviyo, 4000); // Fallback load after 4 seconds
});
</script>
<script type="text/plain" data-lazy-script>
  if (typeof window.fbq === 'undefined') {
    window.fbq = function() {};
  }
  window.fbq('init', '1273926720264895');
  window.fbq('track', 'PageView');
</script>

<script>
window.addEventListener("load", function () {
  document.querySelectorAll("[data-lazy-script]").forEach(function(el) {
    var s = document.createElement("script");
    s.innerHTML = el.innerHTML;
    document.body.appendChild(s);
  });
});
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {
  var lazyHtmlSections = [].slice.call(document.querySelectorAll(".lazy-html"));

  if ("IntersectionObserver" in window) {
    let lazyHtmlObserver = new IntersectionObserver(function(entries, observer) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          let container = entry.target;
          let template = container.querySelector("template");
          if (template) {
            container.innerHTML = template.innerHTML;
            // Trigger a resize event to help any JS sliders/layouts adjust
            window.dispatchEvent(new Event('resize'));
          }
          container.classList.remove("lazy-html");
          container.classList.add("lazy-html--loaded");
          lazyHtmlObserver.unobserve(container);
        }
      });
    }, { rootMargin: "0px 0px 400px 0px" }); // Load 400px before it enters viewport

    lazyHtmlSections.forEach(function(section) {
      lazyHtmlObserver.observe(section);
    });
  }
});
</script>
